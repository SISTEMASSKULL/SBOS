          "device_authorization": {
            "status": "enabled",
            "rfc_ref": "RFC_8628",
            "applies_to": ["EXT_N0", "M2M_IoT"]
          },
          "token_exchange": {
            "status": "enabled_controlled",
            "rfc_ref": "RFC_8693",
            "applies_to": ["SYS", "BIZ_N3_N5"]
          },
          "ciba": {
            "status": "enabled",
            "openid_ref": "CIBA_Core",
            "applies_to": ["EXT_N0", "BIZ_N1"]
          },
          "resource_owner_password": {
            "status": "DISABLED_permanently",
            "rfc_ref": "RFC_6749_§4.3",
            "reason": "Deprecated by OAuth 2.1. Replaced by Authorization Code + PKCE.",
            "bAuth_notes": "NEVER enable this grant in bAuth."
          },
          "implicit": {
            "status": "DISABLED_permanently",
            "rfc_ref": "RFC_6749_§4.2",
            "reason": "Deprecated by OAuth 2.1. Tokens in URL fragment are insecure.",
            "bAuth_notes": "NEVER enable this grant in bAuth."
          },
          "saml2_bearer": {
            "status": "enabled_for_SAML_federation",
            "rfc_ref": "RFC_7522",
            "applies_to": ["BIZ", "EXT"]
          }
        }
      },

      "authenticator_assurance_levels": {
        "AAL1": {
          "description": "Single-factor authentication permitted",
          "kc_methods": ["KC_PASSWORD", "KC_PASSKEY", "KC_EMAIL_OTP", "KC_KERBEROS"],
          "applies_to": ["EXT_N0", "BIZ_N1", "VISITANTE"],
          "restrictions": {
            "no_sms_otp": true,
            "rate_limiting": "10_attempts_per_minute",
            "account_lockout": "after_10_consecutive_failures"
          }
        },
        "AAL2": {
          "description": "Multi-factor authentication required (2 factors)",
          "kc_methods": ["KC_TOTP", "KC_HOTP", "KC_WEBAUTHN_2FA", "KC_CONDITIONAL_OTP", "KC_PASSKEY"],
          "discouraged": ["KC_SMS_OTP"],
          "applies_to": ["BIZ_N2_N5", "SYS_N3"],
          "step_up_enabled": true
        },
        "AAL3": {
          "description": "Phishing-resistant hardware-backed authentication only",
          "kc_methods": ["KC_WEBAUTHN_PASSWORDLESS", "KC_X509"],
          "prohibited": ["KC_SMS_OTP", "KC_TOTP", "KC_EMAIL_OTP"],
          "applies_to": ["SU", "SYS_N1_N2"],
          "channel_binding_required": true
        }
      },

      "step_up_authentication": {
        "rfc_ref": "RFC_9470",
        "description": "Temporary LoA elevation for sensitive operations",
        "example": "Cajero (AAL2) → arqueo general → Step-Up TOTP → AAL3 temporal",
        "max_elevation_duration_minutes": 15,
        "audit_required": true,
        "sod_check": "step_up_approver_cannot_be_requester"
      },

      "mfa_enrollment_policy": {
        "new_user_grace_period_days": 7,
        "mfa_reset_requires_approval": true,
        "mfa_reset_approver": "ROL-SYS-ADMIN-SEGURIDAD or ROL-SYS-ADMIN-TENANT",
        "recovery_codes": {
          "count": 10,
          "single_use": true,
          "hash_algorithm": "SHA256"
        },
        "mfa_methods_per_tier": {
          "SU": { "required": 1, "allowed": ["KC_WEBAUTHN_PASSWORDLESS", "KC_X509"] },
          "SYS_N1_N2": { "required": 1, "allowed": ["KC_WEBAUTHN_PASSWORDLESS", "KC_X509", "KC_TOTP"] },
          "SYS_N3": { "required": 1, "allowed": ["KC_TOTP", "KC_WEBAUTHN_2FA"] },
          "BIZ_N3_N5": { "required": 1, "allowed": ["KC_TOTP", "KC_WEBAUTHN_2FA"] },
          "BIZ_N1_N2": { "required": 0, "recommended": 1, "allowed": ["KC_TOTP", "KC_PASSKEY"] },
          "EXT_N0": { "required": 0, "recommended": 0, "allowed": ["KC_PASSKEY", "KC_EMAIL_OTP"] }
        }
      }
    },

    "section_4_token_oauth2_policies": {
      "title": "SECTION 4 — TOKEN & OAUTH 2.0 POLICIES",
      "description": "JWT/OAuth 2.0 token lifecycle per tier, aligned with OAuth 2.0 Security BCP and MITRE profile.",
      "authorization_server": {
        "provider": "Keycloak_26_6_2",
        "realms": {
          "sbos_system": { "purpose": "SU_N1_N2_N4", "token_lifetime": "5_15_min" },
          "tenant_{id}": { "purpose": "BIZ_N1_N5", "token_lifetime": "30_60_min" },
          "tenant_{id}_ext": { "purpose": "EXT_N0", "token_lifetime": "24_hours" }
        }
      },

      "token_policy_by_tier": {
        "SU": {
          "access_token_ttl_minutes": 5,
          "refresh_token": "none_JIT_only",
          "signing_algorithm": "ES256",
          "token_binding": "mtls_rfc8705",
          "sender_constrained": true,
          "revocation": "immediate_rfc7009"
        },
        "SYS": {
          "access_token_ttl_minutes": 15,
          "refresh_token_ttl_hours": 4,
          "refresh_rotation": "on_every_use",
          "signing_algorithm": "ES256",
          "token_binding": "dpop_rfc9449",
          "sender_constrained": true
        },
        "BIZ_N3_N5": {
          "access_token_ttl_minutes": 30,
          "refresh_token_ttl_hours": 8,
          "refresh_rotation": "on_every_use",
          "pkce_required": true,
          "signing_algorithm": "ES256"
        },
        "BIZ_N1_N2": {
          "access_token_ttl_minutes": 60,
          "refresh_token_ttl_days": 30,
          "refresh_rotation": "on_every_use",
          "pkce_required": true,
          "signing_algorithm": "ES256"
        },
        "EXT_N0": {
          "access_token_ttl_hours": 24,
          "refresh_token_ttl_days": 90,
          "refresh_rotation": "no_manual_revocation",
          "pkce_required": true,
          "signing_algorithm": "ES256"
        },
        "M2M": {
          "access_token_ttl_minutes": 15,
          "refresh_token": "none_client_credentials_only",
          "signing_algorithm": "ES384",
          "token_binding": "mtls_rfc8705",
          "sender_constrained": true,
          "jwt_client_assertion": "rfc7523"
        }
      },

      "jwt_validation": {
        "required_claims": ["exp", "nbf", "iss", "aud", "sub", "jti"],
        "audience_validation": "strict_match_resource_identifier",
        "clock_skew_seconds": 30,
        "reject_query_param_tokens": true,
        "blocklist_enabled": true,
        "blocklist_ttl": "matching_token_ttl"
      },

      "api_gateway": {
        "provider": "Kong_3_9_x",
        "oidc_plugin": {
          "introspection_endpoint": "/realms/{realm}/protocol/openid-connect/token/introspect",
          "injected_headers": ["X-User-Id", "X-Role-Id", "X-Tenant-Id", "X-Ctx-Id"]
        },
        "rate_limiting_by_tier": {
          "SU": "unlimited",
          "SYS": "1000_rps",
          "BIZ_N3_N5": "100_rps",
          "BIZ_N1_N2": "50_rps",
          "EXT_N0": "10_rps",
          "VISITANTE": "1_rps",
          "M2M": "500_rps"
        }
      }
    },

    "section_5_ecosystem_integration": {
      "title": "SECTION 5 — ECOSYSTEM INTEGRATION",
      "description": "Identity lifecycle orchestration across Vault, Kong, Keycloak, and Tryton.",
      "vault_2_0_1": {
        "role": "secret_storage_and_rotation",
        "engines": {
          "pki": {
            "purpose": "M2M_certificates_N4_daemons",
            "ttl_hours": 24,
            "algorithm": "ECDSA_P384",
            "auto_rotation": true,
            "crl_enabled": true
          },
          "database": {
            "purpose": "postgresql_18_4_dynamic_credentials",
            "ttl_days": 30,
            "auto_rotation": true,
            "zero_downtime": true
          },
          "transit": {
            "purpose": "AES_256_GCM_encryption_keys",
            "ttl_days": 90,
            "auto_rewrap": true
          },
          "kv_v2": {
            "purpose": "oauth_client_secrets_api_keys",
            "ttl_days": 90,
            "dual_credential_rotation": true
          }
        },
        "break_glass": {
          "purpose": "SU_emergency_credentials",
          "unseal": "2_of_3_shamir",
          "max_session_hours": 24,
          "sentinel_policies": true
        }
      },

      "keycloak_26_6_2": {
        "role": "authorization_server_identity_provider",
        "per_realm_password_policies": {
          "sbos_system": "length(15)_notUsername(1)_argon2id_t5_m128",
          "tenant": "length(12)_notUsername(1)_argon2id_t3_m64",
          "tenant_ext": "length(8)_notUsername(1)_argon2id_t2_m32"
        },
        "hash_algorithm": "argon2id",
        "deprecated_algorithms": ["sha1", "md5", "bcrypt"],
        "federation_protocols": ["openid_connect", "saml_2_0"],
        "user_storage_spi": "tryton_sync_via_bAuth"
      },

      "kong_3_9_x": {
        "role": "api_gateway_single_external_entry",
        "plugins": {
          "oidc": "jwt_validation_against_keycloak",
          "rate_limiting": "per_tier_per_endpoint",
          "mtls": "M2M_and_NEXUS_clients",
          "cors": "sbos_skull_bo_domains_only",
          "audit_log": "json_to_loki_via_alloy"
        },
        "auth_pipeline": [
          "rate_limit_check",
          "oidc_validate_jwt",
          "extract_claims",
          "inject_headers",
          "mtls_if_applicable",
          "route_to_daemon"
        ],
        "no_http_between_daemons": true,
        "unix_socket_only": "/run/bos/{daemon}.sock"
      },

      "tryton_erp": {
        "role": "business_identity_source_of_truth",
        "synchronization": {
          "engine": "bAuth_reconcile_loop",
          "frequency_seconds": 60,
          "entities": {
            "res_users": { "direction": "tryton_to_keycloak", "target": "tenant_{id}" },
            "res_partner": { "direction": "tryton_to_keycloak", "target": "tenant_{id}_ext" },
            "res_company": { "direction": "bAuth_to_keycloak_admin_api", "target": "realm_creation" },
            "res_branch": { "direction": "bAuth_to_keycloak", "target": "group" },
            "res_department": { "direction": "bAuth_to_keycloak", "target": "group" }
          }
        }
      }
    },

    "section_6_context_plane": {
      "title": "SECTION 6 — CONTEXT PLANE & TRACEABILITY",
      "description": "Distributed context propagation per SBOS-049. W3C Trace Context + OpenTelemetry Baggage.",
      "ctx_id": {
        "mandatory": true,
        "iso_ref": "ISO_27001_A.8.15",
        "structure": {
          "fields": ["tenant_id", "empresa_id", "sucursal_id", "pos_logico", "user_id", "traceparent"],
          "traceparent_format": "W3C_Trace_Context",
          "baggage_format": "OpenTelemetry_Baggage"
        },
        "lifecycle": {
          "creator": "bos_IAM_Installer",
          "propagator": "ctx_orchestrator_S045",
          "validator": "ctx_validator_S046",
          "validation_point": "every_request",
          "reject_without_ctx_id": true
        }
      },

      "audit_logging": {
        "levels": {
          "none": "no_logging",
          "basic": "login_logout",
          "full": "every_operation"
        },
        "default_by_tier": {
          "SU": "full",
          "SYS": "full",
          "BIZ_N3_N5": "basic",
          "BIZ_N1_N2": "basic",
          "EXT_N0": "none",
          "M2M": "full",
          "VISITANTE": "basic"
        },
        "log_destination": "loki_via_alloy",
        "immutable_storage": true,
        "retention": {
          "authentication_events_days": 365,
          "authorization_events_years": 7,
          "privileged_sessions_days": 90
        }
      }
    },

    "section_7_physical_logical_integration": {
      "title": "SECTION 7 — PHYSICAL-LOGICAL AUTHENTICATION",
      "description": "Unified authentication for NEXUS (bhnexus + banexus). Hardware bridges and edge devices.",
      "physical_access": {
        "high_security_areas": {
          "required_factors": 3,
          "methods": ["biometric_fingerprint_iris", "smart_card_contactless", "pin_6_digits"],
          "liveness_detection": true,
          "monitoring": ["video_surveillance", "access_logs", "real_time_alerts"]
        },
        "standard_areas": {
          "required_factors": 2,
          "methods": ["biometric_fingerprint", "smart_card_contactless"]
        },
        "emergency_override": {
          "triggers": ["fire_alarm", "security_breach", "natural_disaster"],
          "audit_required": true,
          "video_recording": true
        }
      },

      "edge_authentication": {
        "banexus_agent": {
          "platform": "Fedora_VDI",
          "interceptors": ["udev_usb", "pam_shell", "polkit"],
          "cache": {
            "type": "policy_cache_ephemeral",
            "encryption": "AES_256_GCM",
            "ttl_seconds": 300
          },
          "offline_operation": {
            "max_period_hours": 24,
            "restricted_operations": ["privilege_escalation", "policy_changes"],
            "sync_mandatory_on_reconnect": true
          }
        },
        "device_requirements": {
          "secure_boot": true,
          "integrity_verification": true,
          "encrypted_storage": true
        }
      },

      "nexus_hardware_bridges": {
        "protocols": ["OSDP", "MQTT", "ONVIF", "Wiegand"],
        "auth_cache": {
          "type": "in_memory",
          "ttl_seconds": 30,
          "max_connections": 10000
        }
      },

      "impossible_travel_detection": {
        "enabled": true,
        "max_speed_kmh": 500,
        "grace_period_minutes": 5,
        "action": "force_reauth_and_alert"
      },

      "concurrent_access_policy": {
        "physical_and_remote_simultaneous": false,
        "multiple_physical_locations": false,
        "exception_approval_required": true
      }
    },

    "section_8_emergency_break_glass": {
      "title": "SECTION 8 — EMERGENCY & BREAK-GLASS PROCEDURES",
      "description": "PAM break-glass for SU and emergency access protocols per ISO 27001 A.8.2.",
      "superuser_break_glass": {
        "activation": "without_prior_approval",
        "post_event_audit_deadline_hours": 24,
        "max_session_hours": 4,
        "session_recording": true,
        "credentials": "vault_2_of_3_unseal",
        "justification_required": true
      },

      "emergency_authentication_fallback": {
        "offline_tokens": {
          "max_validity_hours": 48,
          "usage_limit": 3,
          "encryption": "AES_256_GCM"
        },
        "cached_credentials": {
          "max_cache_hours": 24,
          "limited_permissions": true,
          "mandatory_revalidation": true
        }
      },

      "degraded_operation_modes": {
        "critical_services": {
          "minimum_factors": 2,
          "max_session_hours": 4
        },
        "essential_services": {
          "minimum_factors": 1,
          "max_session_hours": 8,
          "restricted_actions": true
        }
      },

      "service_recovery_priority": [
