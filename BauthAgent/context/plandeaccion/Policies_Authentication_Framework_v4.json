    "section_1_rbac_foundation": {
      "title": "SECTION 1 — RBAC FOUNDATION & ROLE ARCHITECTURE",
      "description": "Core role-based access control model per NIST RBAC Level 3 (Constrained RBAC) with Separation of Duties.",
      "rbac_model": {
        "level": 3,
        "name": "Constrained RBAC",
        "capabilities": ["flat_rbac", "hierarchical_rbac", "static_sod", "dynamic_sod"],
        "role_graph": {
          "type": "directed_acyclic_graph",
          "inheritance": "junior_to_senior",
          "permission_propagation": "OR_bitwise",
          "cycle_prevention": "transitive_closure_check",
          "closure_table": {
            "schema": "rol_closure(ancestro_id, descendiente_id, profundidad)",
            "query_pattern": "single_join_no_recursion",
            "reference": "AWS_IAM_Zanzibar_Cerbos"
          }
        },
        "bitmask_engine": {
          "bits": 64,
          "layers": {
            "layer_1": {
              "bits": "0-31",
              "scope": "system_privileges",
              "assignable_to": ["SU", "SYS"]
            },
            "layer_2": {
              "bits": "32-63",
              "scope": "business_privileges",
              "assignable_to": ["BIZ", "EXT"]
            }
          },
          "operations": {
            "effective_mask": "mask_own OR mask_junior_1 OR mask_junior_2 ...",
            "permission_check": "(mask_eff AND bit_operation) != 0",
            "inheritance": "reflexive_transitive_antisymmetric"
          }
        },
        "separation_of_duties": {
          "static_sod": {
            "description": "Conflicting roles cannot be assigned to the same user",
            "conflicts": [
              ["ROL-COMPRADOR", "ROL-AUDITOR-INTERNO"],
              ["ROL-ENCARGADO-FACTURACION", "ROL-REVISOR-FISCAL"],
              ["ROL-SYS-ADMIN-PROYECTO", "ROL-SYS-ADMIN-SEGURIDAD"],
              ["ROL-JEFE-CONTABILIDAD", "ROL-AUDITOR-EXTERNO-CONTABLE"]
            ]
          },
          "dynamic_sod": {
            "description": "Conflicting roles cannot be activated in the same session",
            "conflicts": [
              ["ROL-CAJERO", "ROL-AUDITOR-INVENTARIO"],
              ["ROL-SUPERVISOR-FACT-COBRANZA", "ROL-COBRADOR"]
            ]
          }
        }
      },

      "role_tiers": {
        "tier_definitions": [
          {
            "tier": "SU",
            "code": "TIER-SUPERUSUARIO",
            "count": 1,
            "aal": 3,
            "description": "Máximo permiso global. Bootstrap, DR, mantenimiento mayor. PAM break-glass.",
            "roles": ["ROL-SYS-SUPERUSUARIO"]
          },
          {
            "tier": "SYS",
            "code": "TIER-SISTEMA",
            "count": 47,
            "sub_tiers": ["N1-Platform", "N2-Module", "N3-Tenant", "N4-Bootstrap"],
            "aal": "2-3",
            "description": "Administración de plataforma, módulos, tenants, bootstrap. Sin relación laboral con tenant.",
            "roles": ["S002-S048"]
          },
          {
            "tier": "BIZ",
            "code": "TIER-NEGOCIO",
            "count": 174,
            "sub_tiers": ["N5-Direccion", "N4-Gerencia", "N3-Supervision", "N2-Tecnico", "N1-Operativo"],
            "aal": "1-3",
            "description": "Roles de negocio. Personal y empleados por sector CAEB."
          },
          {
            "tier": "EXT",
            "code": "TIER-EXTERNO",
            "count": 146,
            "aal": 1,
            "description": "Actor externo. Cliente del sistema (ISO 9001). Identidad verificable, autorización limitada."
          },
          {
            "tier": "M2M",
            "code": "TIER-M2M",
            "count": 29,
            "aal": "n/a",
            "description": "Machine-to-machine. Service accounts, daemons. mTLS obligatorio. Sin contraseña."
          }
        ],

        "role_template_attributes": {
          "mandatory": [
            "role_id", "role_name", "role_type", "tier",
            "parent_role_ids", "mask_own", "description",
            "issuer", "owner_tenant", "start_time",
            "loa_required", "mfa_required", "audit_level"
          ],
          "recommended": [
            "objective", "expiry_time", "step_up_enabled",
            "sod_group", "max_sessions", "session_timeout",
            "template_id"
          ],
          "automatic": ["extensions", "created_at", "updated_at", "version"],
          "standards_ref": "ISO_24760-2:2025 §4.2, §5.1, ANSI_INCITS_359, oneM2M_TS_0001"
        }
      }
    },

    "section_2_password_credential_policies": {
      "title": "SECTION 2 — PASSWORD & CREDENTIAL POLICIES",
      "description": "Per-tier password and credential policies aligned with NIST SP 800-63B Rev.4 (2024).",
      "nist_800_63b_compliance": {
        "core_principles": {
          "length_over_complexity": true,
          "no_composition_rules": true,
          "no_periodic_rotation_without_compromise": true,
          "mandatory_breach_screening": true,
          "password_managers_encouraged": true,
          "no_password_hints": true,
          "no_kba": true,
          "max_length_at_least_64_chars": true
        },
        "deprecated_practices": [
          "SMS_OTP_as_sole_factor",
          "periodic_password_expiration_60_90_days",
          "complexity_rules_upper_lower_digit_special",
          "password_hints",
          "knowledge_based_authentication"
        ]
      },

      "password_policy_by_tier": {
        "SU": {
          "min_length": 20,
          "recommended_length": 32,
          "max_length": 128,
          "hash_algorithm": "argon2id",
          "hash_params": { "t": 5, "m_mb": 128, "p": 2 },
          "screening": ["hibp_k_anonymity", "top_100k_common", "context_terms", "user_history_10"],
          "rotation": "on_compromise_or_post_event_only",
          "mfa": "fido2_webauthn_hardware_token",
          "jit_required": true,
          "session_recording": true
        },
        "SYS": {
          "min_length": 15,
          "recommended_length": 24,
          "max_length": 128,
          "hash_algorithm": "argon2id",
          "hash_params": { "t": 3, "m_mb": 64, "p": 2 },
          "screening": ["hibp_k_anonymity", "top_100k_common", "context_terms", "user_history_10"],
          "rotation": "on_compromise_only",
          "mfa": "totp_or_fido2",
          "separate_admin_account": true
        },
        "BIZ_N3_N5": {
          "min_length": 12,
          "recommended_length": 20,
          "max_length": 64,
          "hash_algorithm": "argon2id",
          "hash_params": { "t": 3, "m_mb": 64, "p": 2 },
          "screening": ["hibp_k_anonymity", "top_100k_common", "context_terms"],
          "rotation": "on_compromise_only",
          "mfa": "totp_or_fido2_recommended"
        },
        "BIZ_N1_N2": {
          "min_length": 10,
          "recommended_length": 15,
          "max_length": 64,
          "hash_algorithm": "argon2id",
          "hash_params": { "t": 2, "m_mb": 32, "p": 1 },
          "screening": ["hibp_k_anonymity", "top_100k_common"],
          "rotation": "on_compromise_only",
          "mfa": "totp_optional"
        },
        "EXT_N0": {
          "min_length": 8,
          "recommended_length": 12,
          "max_length": 64,
          "hash_algorithm": "argon2id",
          "hash_params": { "t": 2, "m_mb": 32, "p": 1 },
          "screening": ["hibp_k_anonymity", "top_100k_common"],
          "rotation": "on_compromise_or_reset_only",
          "mfa": "passkey_webauthn_optional"
        },
        "M2M": {
          "auth_method": "mtls_only",
          "certificate": {
            "type": "x509_ephemeral",
            "ttl_hours": 24,
            "algorithm": "ECDSA_P384",
            "issuer": "vault_pki_engine"
          },
          "no_passwords": true,
          "no_shared_secrets": true,
          "no_api_keys": true
        },
        "VISITANTE": {
          "auth_method": "temporary_credential",
          "types": ["qr_code", "badge", "mobile_pass"],
          "expiry": "on_checkout",
          "no_permanent_account": true
        }
      },

      "password_screening": {
        "sources": [
          {
            "name": "Have_I_Been_Pwned",
            "url": "api.pwnedpasswords.com",
            "method": "k_anonymity",
            "update_frequency": "daily"
          },
          {
            "name": "Top_100K_Common",
            "source": "SecLists_rockyou",
            "update_frequency": "weekly"
          },
          {
            "name": "Context_Terms",
            "source": "username_company_branch_tenant",
            "update_frequency": "realtime"
          },
          {
            "name": "User_Password_History",
            "retention": "last_10_passwords",
            "update_frequency": "on_change"
          }
        ],
        "reject_on_match": true,
        "nist_ref": "SP_800-63B_Rev4_§5.1.1.2"
      }
    },

