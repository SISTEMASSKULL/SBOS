## 8. Tablas SQL del Calendario — 9 CREATE TABLEs

### 8.1 Lista de tablas

| # | Tabla | Schema | Prefijo | Propósito |
|---|-------|--------|---------|-----------|
| 1 | `calendar_event` | bAuth | cal_ | Template del evento (reunión, proceso, recordatorio) |
| 2 | `calendar_instance` | bAuth | cal_ | Ocurrencias materializadas (Google Hybrid Window) |
| 3 | `calendar_exception` | bAuth | cal_ | Cancelaciones y modificaciones de instancias |
| 4 | `calendar_interval` | bAuth | cal_ | Períodos fiscales, feriados, cierres |
| 5 | `calendar_attendee` | bAuth | cal_ | Participantes de reuniones con RSVP |
| 6 | `calendar_reminder` | bAuth | cal_ | Programa de alertas (WhatsApp, SMS, Email, UI) |
| 7 | `calendar_notification` | bAuth | cal_ | Registro WORM de envíos (AUDITORÍA) |
| 8 | `calendar_template` | bGlobal | global_ | Plantillas de mensajes por canal |
| 9 | `calendar_user_prefs` | bAuth | cal_ | Preferencias de notificación por usuario |

### 8.2 SQL Completo

```sql
-- ============================================================
-- CALENDARIO SBOS — 9 Tablas
-- Schema: bAuth (8) + bGlobal (1)
-- Prefijo: cal_ | Motor: rrule_plpgsql + Google Hybrid Window
-- ============================================================

-- 1. CALENDAR EVENT — Template del evento
CREATE TABLE IF NOT EXISTS bAuth.calendar_event (
    event_id          UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id         UUID NOT NULL,
    empresa_id        UUID,
    sucursal_id       UUID,
    owner_id          UUID,
    calendar_name     TEXT DEFAULT 'default',
    event_type        TEXT NOT NULL,
    title             VARCHAR(512) NOT NULL,
    description       TEXT,
    location          VARCHAR(512),
    start_time        TIMESTAMPTZ NOT NULL,
    end_time          TIMESTAMPTZ NOT NULL,
    all_day           BOOLEAN DEFAULT FALSE,
    timezone          VARCHAR(50) DEFAULT 'America/La_Paz',
    rrule             TEXT,
    status            TEXT DEFAULT 'CONFIRMED',
    visibility        TEXT DEFAULT 'DEFAULT',
    process_name      TEXT,
    process_params    JSONB,
    ctx_id            TEXT NOT NULL,
    created_at        TIMESTAMPTZ DEFAULT NOW(),
    updated_at        TIMESTAMPTZ DEFAULT NOW(),
    CONSTRAINT chk_cal_event_type CHECK (event_type IN ('MEETING','PROCESS','REMINDER','FISCAL_EVENT')),
    CONSTRAINT chk_cal_event_status CHECK (status IN ('CONFIRMED','TENTATIVE','CANCELLED')),
    CONSTRAINT chk_cal_visibility CHECK (visibility IN ('DEFAULT','PUBLIC','PRIVATE'))
);
CREATE INDEX IF NOT EXISTS idx_cal_event_time ON bAuth.calendar_event(tenant_id, start_time, end_time);
CREATE INDEX IF NOT EXISTS idx_cal_event_owner ON bAuth.calendar_event(owner_id, tenant_id);

-- 2. CALENDAR INSTANCE — Ocurrencias materializadas
CREATE TABLE IF NOT EXISTS bAuth.calendar_instance (
    instance_id       UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    event_id          UUID NOT NULL,
    tenant_id         UUID NOT NULL,
    original_date     DATE NOT NULL,
    start_time        TIMESTAMPTZ NOT NULL,
    end_time          TIMESTAMPTZ NOT NULL,
    is_exception      BOOLEAN DEFAULT FALSE,
    status            TEXT DEFAULT 'CONFIRMED',
    ctx_id            TEXT,
    created_at        TIMESTAMPTZ DEFAULT NOW(),
    UNIQUE (event_id, original_date)
);
CREATE INDEX IF NOT EXISTS idx_cal_inst_time ON bAuth.calendar_instance(tenant_id, start_time, end_time);
CREATE INDEX IF NOT EXISTS idx_cal_inst_event ON bAuth.calendar_instance(event_id, original_date);

-- 3. CALENDAR EXCEPTION — Modificaciones/Cancelaciones
CREATE TABLE IF NOT EXISTS bAuth.calendar_exception (
    exception_id      UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    event_id          UUID,
    interval_id       TEXT,
    original_date     DATE NOT NULL,
    exception_type    TEXT NOT NULL,
    modified_start    TIMESTAMPTZ,
    modified_end      TIMESTAMPTZ,
    reason            TEXT,
    ctx_id            TEXT NOT NULL,
    created_at        TIMESTAMPTZ DEFAULT NOW(),
    UNIQUE (event_id, interval_id, original_date),
    CONSTRAINT chk_cal_exc_target CHECK (
        (event_id IS NOT NULL AND interval_id IS NULL) OR
        (event_id IS NULL AND interval_id IS NOT NULL)
    ),
    CONSTRAINT chk_cal_exc_type CHECK (exception_type IN ('CANCELLED','MODIFIED'))
);

-- 4. CALENDAR INTERVAL — Períodos fiscales
CREATE TABLE IF NOT EXISTS bAuth.calendar_interval (
    interval_id       TEXT PRIMARY KEY,
    tenant_id         UUID NOT NULL,
    empresa_id        UUID,
    sucursal_id       UUID,
    interval_type     TEXT NOT NULL,
    start_date        DATE NOT NULL,
    end_date          DATE NOT NULL,
    parent_interval   TEXT,
    rrule             TEXT,
    status            TEXT DEFAULT 'OPEN',
    postable_from     DATE,
    postable_until    DATE,
    closed_by         UUID,
    closed_at         TIMESTAMPTZ,
    ctx_id            TEXT NOT NULL,
    created_at        TIMESTAMPTZ DEFAULT NOW(),
    UNIQUE (tenant_id, empresa_id, sucursal_id, interval_id),
    CONSTRAINT chk_cal_int_status CHECK (status IN ('OPEN','SOFT_CLOSED','HARD_CLOSED','ARCHIVED')),
    CONSTRAINT chk_cal_int_type CHECK (interval_type IN ('FISCAL_YEAR','QUARTER','MONTH','WEEK','DAY','HOLIDAY','CUSTOM'))
);

-- 5. CALENDAR ATTENDEE — Participantes
CREATE TABLE IF NOT EXISTS bAuth.calendar_attendee (
    attendee_id       UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    event_id          UUID NOT NULL,
    user_id           UUID NOT NULL,
    response_status   TEXT DEFAULT 'PENDING',
    is_organizer      BOOLEAN DEFAULT FALSE,
    notified_at       TIMESTAMPTZ,
    created_at        TIMESTAMPTZ DEFAULT NOW(),
    UNIQUE (event_id, user_id),
    CONSTRAINT chk_cal_att_status CHECK (response_status IN ('PENDING','ACCEPTED','DECLINED','TENTATIVE'))
);

-- 6. CALENDAR REMINDER — Programa de alertas
CREATE TABLE IF NOT EXISTS bAuth.calendar_reminder (
    reminder_id       UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    event_id          UUID NOT NULL,
    user_id           UUID NOT NULL,
    remind_at         TIMESTAMPTZ NOT NULL,
    offset_minutes    INTEGER NOT NULL,
    channel           TEXT NOT NULL,
    priority          TEXT DEFAULT 'MEDIUM',
    status            TEXT DEFAULT 'PENDING',
    retry_count       INTEGER DEFAULT 0,
    max_retries       INTEGER DEFAULT 3,
    sent_at           TIMESTAMPTZ,
    delivered_at      TIMESTAMPTZ,
    read_at           TIMESTAMPTZ,
    error_message     TEXT,
    ctx_id            TEXT NOT NULL,
    created_at        TIMESTAMPTZ DEFAULT NOW(),
    CONSTRAINT chk_cal_rem_ch CHECK (channel IN ('WHATSAPP','SMS','EMAIL','UI','PUSH')),
    CONSTRAINT chk_cal_rem_st CHECK (status IN ('PENDING','SENT','DELIVERED','FAILED','READ'))
);
CREATE INDEX IF NOT EXISTS idx_cal_rem_fire ON bAuth.calendar_reminder(remind_at, status) WHERE status = 'PENDING';

-- 7. CALENDAR NOTIFICATION — Auditoría WORM de envíos
CREATE TABLE IF NOT EXISTS bAuth.calendar_notification (
    notification_id   UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    reminder_id       UUID,
    user_id           UUID NOT NULL,
    channel           TEXT NOT NULL,
    subject           VARCHAR(512),
    body              TEXT,
    provider          TEXT,
    provider_msg_id   TEXT,
    provider_response JSONB,
    status            TEXT DEFAULT 'PENDING',
    delivered_at      TIMESTAMPTZ,
    read_at           TIMESTAMPTZ,
    error_message     TEXT,
    ctx_id            TEXT NOT NULL,
    created_at        TIMESTAMPTZ DEFAULT NOW(),
    CONSTRAINT chk_cal_not_ch CHECK (channel IN ('WHATSAPP','SMS','EMAIL','UI','PUSH'))
);
CREATE INDEX IF NOT EXISTS idx_cal_not_user ON bAuth.calendar_notification(user_id, created_at DESC);

-- 8. CALENDAR TEMPLATE — Plantillas de mensajes (bGlobal)
CREATE TABLE IF NOT EXISTS bGlobal.calendar_template (
    template_id       UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name              TEXT NOT NULL UNIQUE,
    channel           TEXT NOT NULL,
    subject           VARCHAR(512),
    body_template     TEXT NOT NULL,
    variables         JSONB,
    created_at        TIMESTAMPTZ DEFAULT NOW(),
    CONSTRAINT chk_cal_tpl_ch CHECK (channel IN ('WHATSAPP','SMS','EMAIL','UI','PUSH'))
);

-- 9. CALENDAR USER PREFS — Preferencias por usuario
CREATE TABLE IF NOT EXISTS bAuth.calendar_user_prefs (
    pref_id           UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id           UUID NOT NULL,
    channel           TEXT NOT NULL,
    enabled           BOOLEAN DEFAULT TRUE,
    quiet_start       TIME,
    quiet_end         TIME,
    frequency         TEXT DEFAULT 'IMMEDIATE',
    UNIQUE (user_id, channel),
    CONSTRAINT chk_cal_pref_ch CHECK (channel IN ('WHATSAPP','SMS','EMAIL','UI','PUSH')),
    CONSTRAINT chk_cal_pref_fr CHECK (frequency IN ('IMMEDIATE','DIGEST_DAILY','DIGEST_WEEKLY'))
);
```

