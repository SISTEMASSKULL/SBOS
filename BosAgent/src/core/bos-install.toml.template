# ============================================================================
# bos-install.toml — Configuración de instalación por empresa
#
# FILOSOFÍA: define lo mínimo. El instalador deriva todo lo demás.
#
# Ejemplo completo para una empresa boliviana:
#   client_domain = "sksistemas.com"       → mail.sksistemas.com, admin@sksistemas.com,
#                                             erp.sksistemas.com, docs.sksistemas.com, etc.
#   country       = "BO"                   → moneda BOB, plan contable boliviano, idioma es
#   admin_email   = "admin@sksistemas.com" → superusuario en Keycloak, Tryton, OrangeHRM, etc.
#
# Las secciones "DERIVADO AUTOMÁTICAMENTE" no necesitas tocarlas.
# Solo las secciones "REQUERIDO" son obligatorias.
# ============================================================================

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# BLOQUE 1 — IDENTIDAD DE LA EMPRESA
# Estas 4 variables generan automáticamente TODOS los subdominios, nombres de
# realm, rutas Vault, IDs de Kong, configuraciones de apps, etc.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Dominio principal del servidor (sin https://, sin www)
# → Genera: mail.${domain}, erp.${domain}, rrhh.${domain}, docs.${domain},
#           notas.${domain}, correo.${domain}, auth.${domain}, drive.${domain},
#           monitor.${domain}, vault.${domain}, api.${domain}, ...
# → DNS A record debe apuntar a server_ip
# REQUERIDO
client_domain = "sksistemas.com"

# Nombre completo de la empresa
# → Aparece en: Keycloak (nombre del realm), Tryton (empresa), OrangeHRM (empresa),
#               GNU Health (institución), emails del sistema, Nextcloud (nombre instancia)
# REQUERIDO
org_name = "Sistemas SKULL"

# Slug corto: minúsculas, sin espacios, máx 20 chars
# → Se convierte en: TENANT_ID (realm Keycloak), prefijo Vault, ID Kong consumer,
#                    nombre de namespace alternativo, etiquetas K8s
# → Ejemplo: "acme", "mifirma", "sksistemas", "grupoabc"
# REQUERIDO
org_short = "SKULL"

# IP pública del servidor
# → Usada en: certbot (validación DNS), nginx, logs de auditoría
# REQUERIDO
server_ip = "13.140.128.230"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# BLOQUE 2 — SUPERUSUARIO DEL PRIMER TENANT
# Un solo usuario administra todas las aplicaciones del sistema.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Contraseña inicial única para todas las apps
# → Se propaga a: Keycloak, keycloak_admin, Tryton, OrangeHRM, Nextcloud, Grafana
# → CAMBIAR después del primer login
# REQUERIDO — mín 16 chars con mayúsculas + minúsculas + números + símbolos
admin_password = "12345678abcD_sksistemas"

# Nombre completo del administrador
# REQUERIDO
admin_name = "Administrador Principal SBOS"

# Email del administrador — DERIVADO automáticamente: admin@${client_domain}
# Solo definir aquí si quieres usar otro email diferente al derivado.
# Ejemplo: si client_domain = "sksistemas.com" → admin_email = "admin@sksistemas.com"
# admin_email = ""   # DERIVADO: admin@${client_domain}

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# BLOQUE 3 — LOCALIZACIÓN
# Todo el sistema se adapta automáticamente al país y idioma indicados.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Zona horaria
# Ver: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# → Afecta: cron jobs, timestamps, emails, Tryton (año fiscal), AlertManager
# REQUERIDO
timezone = "America/La_Paz"

# Código de país ISO 3166-1 alpha-2
# → Deriva automáticamente:
#     BO → moneda=BOB, plan_contable=account_bo, ocr=spa+eng, holidays=bolivianas
#     MX → moneda=MXN, plan_contable=account_mx, ocr=spa+eng, holidays=mexicanas
#     ES → moneda=EUR, plan_contable=account_es, ocr=spa+eng, holidays=españolas
#     AR → moneda=ARS, plan_contable=account_ar
#     CO → moneda=COP, plan_contable=account_co
#     EC → moneda=USD, plan_contable=account_ec
# REQUERIDO
country = "BO"

# Idioma principal
# → Afecta: idioma UI Keycloak, OrangeHRM, Tryton, idiomas OCR Paperless
# REQUERIDO
language = "es"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# BLOQUE 4 — OVERRIDES OPCIONALES
# Solo completar si el valor derivado automáticamente NO es correcto.
# Dejar comentado = usar el valor derivado.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

