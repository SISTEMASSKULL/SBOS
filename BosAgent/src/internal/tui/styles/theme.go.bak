		TextDisabled:  lipgloss.Color(PrimAmber900),  // #78350f — marrón oscuro
	},
}

// ActiveTheme es el tema activo en esta sesión.
// Se establece una sola vez vía ApplyTheme() antes del loop TEA.
var ActiveTheme = Themes["abyss"]

// ApplyTheme aplica el tema con el ID dado mutando los tokens semánticos
// y reconstruyendo los componentes de Capa 3 que dependen de ellos.
//
// DEBE llamarse antes de tea.NewProgram() — una sola vez, nunca en runtime.
// Si id es vacío o desconocido, aplica "abyss" como fallback.
func ApplyTheme(id string) {
	t, ok := Themes[id]
	if !ok {
		t = Themes["abyss"]
	}
	ActiveTheme = t

	// ── Mutar tokens de acento (Capa 2B) ─────────────────────────────────────
	ColorAccent        = t.Accent
	ColorAccentText  = t.AccentText

	// ── Mutar tokens de superficie ────────────────────────────────────────────
	ColorBgBase     = t.BgBase
	ColorBgSurface  = t.BgSurface
	ColorBgElevated = t.BgElevated
	ColorBorder     = t.BgElevated    // borde = superficie elevada
	ColorBg1        = t.BgBase
	ColorBg2        = t.BgSurface
	ColorBg3        = t.BgElevated
	ColorBlack      = t.BgBase        // alias histórico

	// ── Mutar tokens de layout ────────────────────────────────────────────────
	ColorTopBarBg     = t.TopBarBg
	ColorMenuActiveBg = t.MenuBg

	// ── Mutar tokens de texto — escala tipográfica del tema ──────────────────
	// Cada tema define sus propios neutros. Sin esto, Slate/Dim/Muted siempre
	// serían azul-gris (slate) aunque el tema sea verde, índigo o ámbar.
	ColorTextPrimary   = t.TextPrimary
	ColorTextSecondary = t.TextSecondary
	ColorTextDisabled  = t.TextDisabled
	// Mantener aliases históricos alineados con la escala del tema activo
	ColorWhite = t.TextPrimary   // texto principal (no literalmente blanco)
	ColorMuted = t.TextDisabled  // texto tenue (alias → disabled del tema)

	// Reconstruir componentes de Capa 3 que leen los tokens mutados
	rebuildThemeComponents()
}

// rebuildThemeComponents reconstruye todos los estilos de Capa 3 (tokens_component.go)
// que dependen de los tokens mutados por ApplyTheme.
// REGLA: Todo estilo de pantalla viene de aquí — ninguna pantalla crea lipgloss.NewStyle() inline.
func rebuildThemeComponents() {
	// ── Texto base — escala tipográfica del tema ──────────────────────────────
	// Reconstruir PRIMERO porque otros componentes los usan.
	White    = lipgloss.NewStyle().Foreground(ColorTextPrimary)    // texto principal del tema
	Dim      = lipgloss.NewStyle().Foreground(ColorTextDisabled)   // texto más sutil del tema
	Muted    = lipgloss.NewStyle().Foreground(ColorTextSecondary)  // texto secundario del tema
	Slate    = lipgloss.NewStyle().Foreground(ColorTextDisabled)   // alias → mismo que Dim en todos los temas
	Inactive = lipgloss.NewStyle().Foreground(ColorTextDisabled)   // opción/elemento deshabilitado

	// ── Acento ────────────────────────────────────────────────────────────────
	Cyan      = lipgloss.NewStyle().Foreground(ColorAccent)
	AccentBold = lipgloss.NewStyle().Foreground(ColorAccent).Bold(true)

	// ── Componentes estructurales ─────────────────────────────────────────────
	TopBar = lipgloss.NewStyle().
		Background(ColorTopBarBg).
		Foreground(ColorAccent).
		Bold(true).
		Padding(0, 1)

	Panel = lipgloss.NewStyle().
		Background(ColorBgSurface).
		Foreground(ColorTextPrimary).
		BorderStyle(lipgloss.NormalBorder()).
		BorderForeground(ColorBorder)

	BoxActive = lipgloss.NewStyle().
		Border(lipgloss.RoundedBorder()).
		BorderForeground(ColorAccent).
		Padding(0, 1)

	Box = lipgloss.NewStyle().
		Border(lipgloss.RoundedBorder()).
		BorderForeground(ColorBorder).
		Padding(0, 1)

	Rule = lipgloss.NewStyle().Foreground(ColorBorder)

	// ── Tablas — encabezados usan texto primario del tema ─────────────────────
	TableHeader = lipgloss.NewStyle().Foreground(ColorTextPrimary)

	// ── Menú dashboard ────────────────────────────────────────────────────────
	MenuItemActive = lipgloss.NewStyle().
		Foreground(ColorAccentText).
		Background(ColorMenuActiveBg).
		Bold(true)

	MenuItemFocused = lipgloss.NewStyle().
		Foreground(ColorTextPrimary)

	MenuItemNormal = lipgloss.NewStyle().
		Foreground(ColorTextSecondary)

	// ── Menú wizard ───────────────────────────────────────────────────────────
	WizardMenuActive = lipgloss.NewStyle().
		Background(ColorMenuActiveBg).
		Foreground(ColorAccent).
		Bold(true).
		PaddingLeft(1).PaddingRight(2)

	// ── Listas — background usa ColorMenuActiveBg (tema activo, no ColorAccentSubtle fijo) ──
	ListItemActive = lipgloss.NewStyle().
		Foreground(ColorAccentText).
		Background(ColorMenuActiveBg).
		BorderLeft(true).
		BorderForeground(ColorAccent).
		PaddingLeft(1)

	// ── Inputs ────────────────────────────────────────────────────────────────
	InputActive = lipgloss.NewStyle().
		Border(lipgloss.NormalBorder()).
		BorderForeground(ColorAccent).
		Background(ColorBgBase).
		Padding(0)

	InputInactive = lipgloss.NewStyle().
		Border(lipgloss.NormalBorder()).
		BorderForeground(ColorBorder).
		Background(ColorBgBase).
		Padding(0)

	// ── Pasos de instalación ──────────────────────────────────────────────────
	StepOK     = lipgloss.NewStyle().Foreground(ColorAccent)
	StepActive = lipgloss.NewStyle().Foreground(ColorAccent).Bold(true)

	// ── Etiquetas de formulario ───────────────────────────────────────────────
	LabelActive = lipgloss.NewStyle().Foreground(ColorAccent).Bold(true).Width(22)

	// ── Título de sección — texto secundario del tema, itálica ──────────────
	SectionTitle = lipgloss.NewStyle().Foreground(ColorTextSecondary).Italic(true)

	// ── Scrollbars — track usa texto disabled del tema ────────────────────────
	ScrollTrack = lipgloss.NewStyle().Foreground(ColorTextDisabled)
	ScrollThumb = lipgloss.NewStyle().Foreground(ColorAccent)

	// ── Footer — texto secundario sobre superficie del tema ──────────────────
	Footer = lipgloss.NewStyle().
		Background(ColorBgSurface).
		Foreground(ColorTextSecondary).
		Padding(0, 1)

	// ── C-05: Tokens de acento (reconstruidos con cada tema) ─────────────────
	TabActive    = lipgloss.NewStyle().Foreground(ColorAccent).Bold(true).Underline(true)
	DataAccent   = lipgloss.NewStyle().Foreground(ColorAccent)
	MetricRX     = lipgloss.NewStyle().Foreground(ColorAccent)
	AccentBar    = lipgloss.NewStyle().Foreground(ColorAccent)
	ResourceName = lipgloss.NewStyle().Foreground(ColorAccent).Bold(true)
	CountOK      = lipgloss.NewStyle().Foreground(ColorAccent)
	DaemonName   = lipgloss.NewStyle().Foreground(ColorAccent).Bold(true)
	LinkText     = lipgloss.NewStyle().Foreground(ColorAccent).Underline(true)
	KeyHint      = lipgloss.NewStyle().Foreground(ColorAccent)

	// ── Estructurales faltantes — borde usa ColorBorder del tema activo ───────
	PanelDiv = lipgloss.NewStyle().
		BorderLeft(true).
		BorderStyle(lipgloss.NormalBorder()).
		BorderForeground(ColorBorder).
		PaddingLeft(2)

	HelpBox = lipgloss.NewStyle().
		BorderLeft(true).
		BorderStyle(lipgloss.NormalBorder()).
		BorderForeground(ColorBorder).
		PaddingLeft(2).
		Foreground(ColorTextSecondary)

	// ── Formularios — escala tipográfica del tema ─────────────────────────────
	Label      = lipgloss.NewStyle().Foreground(ColorTextDisabled).Width(22)
	StepPending = lipgloss.NewStyle().Foreground(ColorTextDisabled)

	// ── Alias de texto secundario (reconstruir para que sigan la escala del tema) ──
	DimItalic = lipgloss.NewStyle().Foreground(ColorTextDisabled).Italic(true)
	Subtitle  = lipgloss.NewStyle().Foreground(ColorTextSecondary)

	// ── Notificaciones inline — fondo usa ColorBgElevated del tema activo ─────
	NotifyBarBg = lipgloss.NewStyle().Background(ColorBgElevated).Width(80)
}
