{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "NGINX Ingress — HOST S02 — SBOS. Métricas de nginx-exporter (stub_status :9113). NO es pod K8s.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "nginx activo",
      "description": "nginx corriendo como proceso systemd en HOST S02",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "nginx_up{job=\"nginx-s02\"}",
          "legendFormat": "nginx up"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": 0 }, { "color": "green", "value": 1 }] }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Conexiones activas",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "nginx_connections_active{job=\"nginx-s02\"}", "legendFormat": "activas" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Requests / segundo",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "rate(nginx_http_requests_total{job=\"nginx-s02\"}[1m])", "legendFormat": "req/s" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Requests por segundo (a Kong)",
      "description": "Todo request que llega a nginx se delega a Kong. Esta métrica representa el tráfico total del Ingress.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "rate(nginx_http_requests_total{job=\"nginx-s02\"}[1m])",
          "legendFormat": "req/s → Kong"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Conexiones nginx (activas / waiting / writing)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "nginx_connections_active{job=\"nginx-s02\"}", "legendFormat": "activas" },
        { "expr": "nginx_connections_waiting{job=\"nginx-s02\"}", "legendFormat": "waiting (keepalive)" },
        { "expr": "nginx_connections_writing{job=\"nginx-s02\"}", "legendFormat": "writing" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["sbos", "nginx", "ingress", "s02", "host"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(nginx_up, instance)",
        "name": "instance",
        "query": "label_values(nginx_up, instance)",
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "NGINX Ingress — HOST S02",
  "uid": "sbos-nginx-s02-ingress",
  "version": 1
}
