---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: stalwart-netpol
  namespace: sbos-comms
  labels:
    sbos-ficha: stalwart
spec:
  podSelector:
    matchLabels:
      app: stalwart
  policyTypes:
    - Ingress
  ingress:
    # Nginx reverse proxy → Stalwart (puertos mail)
    - from:
        - namespaceSelector:
            matchLabels:
              sbos-role: gateway
        - podSelector:
            matchLabels:
              app: nginx
      ports:
        - protocol: TCP
          port: 25
        - protocol: TCP
          port: 587
        - protocol: TCP
          port: 143
        - protocol: TCP
          port: 993
        - protocol: TCP
          port: 110
        - protocol: TCP
          port: 995
        - protocol: TCP
          port: 4190
    # Acceso admin desde namespace interno
    - from:
        - namespaceSelector:
            matchLabels:
              sbos-role: internal
      ports:
        - protocol: TCP
          port: 8080
