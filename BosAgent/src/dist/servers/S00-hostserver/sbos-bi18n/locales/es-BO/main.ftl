# Fluent Translation — es-BO (Español Bolivia)
# Formato de fecha: DD/MM/YYYY
# Separador decimal: ,
# Separador miles: .
# Moneda: BOB (Boliviano)
# Zona horaria: America/La_Paz (UTC-4)

date-format = { DATETIME($date, dateStyle: "short") }
time-format = { DATETIME($time, timeStyle: "short") }
currency-symbol = Bs.
decimal-separator = ,
thousands-separator = .
