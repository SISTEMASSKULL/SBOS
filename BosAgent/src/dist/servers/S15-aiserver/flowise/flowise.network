---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: flowise-netpol
  namespace: sbos-ai
spec:
  podSelector:
    matchLabels:
      app: flowise
  policyTypes:
    - Ingress
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              sbos-role: internal

      ports:
        - protocol: TCP
          port: 3000
