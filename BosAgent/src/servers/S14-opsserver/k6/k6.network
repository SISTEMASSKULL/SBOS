---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: k6-netpol
  namespace: sbos-ops
spec:
  podSelector:
    matchLabels:
      app: k6
  policyTypes:
    - Ingress
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              sbos-role: internal

      ports:
        - protocol: TCP
          port: 6565
