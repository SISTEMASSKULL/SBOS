---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: modsecurity-netpol
  namespace: sbos-gateway
spec:
  podSelector:
    matchLabels:
      app: modsecurity
  policyTypes:
    - Ingress
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              sbos-role: internal

      ports:
        - protocol: TCP
          port: 80
