---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: dovecot-netpol
  namespace: sbos-comms
spec:
  podSelector:
    matchLabels:
      app: dovecot
  policyTypes:
    - Ingress
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              sbos-role: internal

      ports:
        - protocol: TCP
          port: 143
