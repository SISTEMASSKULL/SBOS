---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: openvas-netpol
  namespace: sbos-identity
spec:
  podSelector:
    matchLabels:
      app: openvas
  policyTypes:
    - Ingress
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              sbos-role: internal

      ports:
        - protocol: TCP
          port: 9392
