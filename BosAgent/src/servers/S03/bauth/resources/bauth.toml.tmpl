# bauth.toml — Configuración del daemon bAuth
# Generado por BOS en instalación — NO editar manualmente
# Variables sustituidas: {{PG_DSN}}, {{SOCKET_PATH}}

[database]
url = "{{PG_DSN}}"
pool_size = 5
connect_timeout_secs = 10

[server]
socket_path = "/tmp/bauth/bauth.sock"
socket_perms = 438
socket_group = "bosagent"
max_connections = 50

[logging]
level = "info"
