---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: fedora-kde-netpol
  namespace: sbos-vdi
spec:
  podSelector:
    matchLabels:
      app: fedora-kde
  policyTypes:
    - Ingress
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              sbos-role: internal

      ports:
        - protocol: TCP
          port: 5900
