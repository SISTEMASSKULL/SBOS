---
# NetworkPolicy para los pods de Tryton ERP.
# ÚNICO origen permitido: oauth2-proxy-tryton (mismo namespace sbos-erp).
# Nadie puede llegar a Tryton:8000 directamente — todo pasa por el proxy de auth.
# Garantiza que la autenticación no puede ser saltada.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: tryton-netpol
  namespace: sbos-erp
spec:
  podSelector:
    matchLabels:
      app: tryton
  policyTypes:
    - Ingress
  ingress:
    - from:
        - podSelector:
            matchLabels:
              app: oauth2-proxy-tryton
      ports:
        - protocol: TCP
          port: 8000
