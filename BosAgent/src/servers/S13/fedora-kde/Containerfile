FROM registry.fedoraproject.org/fedora:44

LABEL maintainer="SBOS" \
      description="SBOS Corporate Desktop — Fedora 44 XFCE 4 + TigerVNC + noVNC + Windows 11 Theme (Fluent-Dark + Kvantum)" \
      version="4.0.0"

ENV LANG=es_ES.UTF-8 \
    LC_ALL=es_ES.UTF-8 \
    DISPLAY=:1 \
    RESOLUTION=1920x1080 \
    DEPTH=24

# ── Paquetes base ─────────────────────────────────────────────────────────────
# xfwm4 tiene compositor software propio — no necesita GPU ni kwin
RUN dnf install -y --setopt=install_weak_deps=False --skip-unavailable \
    # XFCE4 — desktop environment ligero, funciona en VNC sin GPU
    xfce4-session \
    xfwm4 \
    xfce4-panel \
    xfdesktop \
    xfce4-settings \
    xfconf \
    xfce4-power-manager \
    # Aplicaciones XFCE
    xfce4-terminal \
    thunar \
    xfce4-notifyd \
    mousepad \
    # Gestión de archivos
    ark \
    # kvantum: estilo Qt/Fluent para aplicaciones Qt
    kvantum \
    # Browser
    chromium \
    # VNC
    tigervnc-server \
    novnc \
    python3-websockify \
    # X11 utils
    dbus-x11 \
    xdg-user-dirs \
    xdg-utils \
    xsetroot \
    # Iconos GTK
    gtk-update-icon-cache \
    # Fuentes Windows-compatible
    google-noto-sans-fonts \
    google-noto-serif-fonts \
    google-noto-emoji-fonts \
    liberation-fonts \
    # Español
    glibc-langpack-es \
    # Sistema
    procps-ng \
    net-tools \
    curl \
    wget \
    which \
    && dnf clean all \
    && rm -rf /var/cache/dnf /var/log/dnf*

# ── Fluent-gtk-theme — tema GTK estilo Windows 11 / Fluent Design ─────────────
RUN curl -sL "https://github.com/vinceliuice/Fluent-gtk-theme/archive/refs/heads/main.tar.gz" \
        -o /tmp/fluent-gtk.tar.gz 2>/dev/null \
    || curl -sL "https://github.com/vinceliuice/Fluent-gtk-theme/archive/refs/heads/master.tar.gz" \
        -o /tmp/fluent-gtk.tar.gz 2>/dev/null \
    && tar -xzC /tmp/ -f /tmp/fluent-gtk.tar.gz \
    && FLUENTDIR=$(find /tmp -maxdepth 1 -type d -name 'Fluent-gtk-theme-*' | head -1) \
    && bash "$FLUENTDIR/install.sh" -d /usr/share/themes --tweaks round 2>/dev/null || true \
    && rm -rf /tmp/fluent-gtk.tar.gz "$FLUENTDIR"

# ── Fluent-kde — Kvantum theme estilo Windows 11 para apps Qt ─────────────────
RUN curl -sL "https://github.com/vinceliuice/Fluent-kde/archive/refs/heads/main.tar.gz" \
        -o /tmp/fluent-kde.tar.gz 2>/dev/null \
    || curl -sL "https://github.com/vinceliuice/Fluent-kde/archive/refs/heads/master.tar.gz" \
        -o /tmp/fluent-kde.tar.gz 2>/dev/null \
    && tar -xzC /tmp/ -f /tmp/fluent-kde.tar.gz \
    && FLUENTDIR=$(find /tmp -maxdepth 1 -type d -name 'Fluent-kde-*' | head -1) \
    && bash "$FLUENTDIR/install.sh" 2>/dev/null || true \
    && rm -rf /tmp/fluent-kde.tar.gz "$FLUENTDIR"

# ── Fluent icons — iconos estilo Windows 11 / Fluent Design ──────────────────
RUN curl -sL "https://github.com/vinceliuice/Fluent-icon-theme/archive/refs/heads/master.tar.gz" \
        | tar -xzC /tmp/ \
    && bash /tmp/Fluent-icon-theme-master/install.sh 2>/dev/null || true \
    && rm -rf /tmp/Fluent-icon-theme-master \
    && gtk-update-icon-cache -f /usr/share/icons/Fluent-dark 2>/dev/null || true \
    && gtk-update-icon-cache -f /usr/share/icons/Fluent 2>/dev/null || true

# ── Cursor Fluent-dark ────────────────────────────────────────────────────────
RUN curl -sL "https://github.com/vinceliuice/Fluent-icon-theme/archive/refs/heads/master.tar.gz" \
        | tar -xzC /tmp/ 2>/dev/null || true \
    && (ls /usr/share/icons/Fluent-dark/cursors/ 2>/dev/null | grep -q xcursor && echo "cursor ok") || \
       (find /tmp/Fluent-icon-theme-master -name "install.sh" -exec bash {} \; 2>/dev/null || true) \
    && rm -rf /tmp/Fluent-icon-theme-master 2>/dev/null || true

# ── Tema XFWM4 Win11-Dark — decoraciones de ventana estilo Windows 11 ─────────
RUN mkdir -p /usr/share/xfwm4/themes/Win11-Dark \
    && printf '%s\n' \
       'active_color_1=#202020' \
       'active_color_2=#202020' \
       'active_mid_color=#202020' \
       'inactive_color_1=#2a2a2a' \
       'inactive_color_2=#2a2a2a' \
       'inactive_mid_color=#2a2a2a' \
       'active_text_color=#f0f0f0' \
       'inactive_text_color=#888888' \
       'active_border_color=#3a3a3a' \
       'inactive_border_color=#3a3a3a' \
       'active_hilight_1=#0078d4' \
       'active_hilight_2=#005fb8' \
       'inactive_hilight_1=#3a3a3a' \
       'inactive_hilight_2=#3a3a3a' \
       'button_layout=O|HMC' \
       'button_offset=2' \
       'button_spacing=6' \
       'full_width_title=true' \
       'show_app_icon=true' \
       'title_shadow_active=false' \
       'title_shadow_inactive=false' \
       'title_vertical_offset_active=1' \
       'title_vertical_offset_inactive=1' \
       > /usr/share/xfwm4/themes/Win11-Dark/themerc

# ── Wallpaper Windows 11 Bloom ────────────────────────────────────────────────
RUN mkdir -p /usr/share/wallpapers/Windows11/contents/images \
    && curl -sL \
      "https://raw.githubusercontent.com/kkrypt0nn/Windows-11-Wallpapers/main/Wallpapers/Bloom/img0_dark.jpg" \
      -o /usr/share/wallpapers/Windows11/contents/images/1920x1080.jpg 2>/dev/null \
    || curl -sL \
      "https://raw.githubusercontent.com/kkrypt0nn/Windows-11-Wallpapers/main/Wallpapers/Bloom/img0.jpg" \
      -o /usr/share/wallpapers/Windows11/contents/images/1920x1080.jpg 2>/dev/null \
    || true

# ── Usuario del desktop ───────────────────────────────────────────────────────
RUN useradd -u 1001 -ms /bin/bash sbosuser && \
    echo "sbosuser ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/sbosuser && \
    chmod 440 /etc/sudoers.d/sbosuser

RUN mkdir -p /etc/sbos-desktop

# ── Archivos del sistema ───────────────────────────────────────────────────────
COPY resources/xstartup /etc/sbos-desktop/xstartup
RUN chmod +x /etc/sbos-desktop/xstartup

COPY resources/xfce-defaults/ /etc/sbos-desktop/xfce-defaults/
COPY resources/novnc-index.html /usr/share/novnc/index.html
COPY resources/start-desktop.sh /start-desktop.sh
RUN chmod +x /start-desktop.sh

EXPOSE 6901

CMD ["/start-desktop.sh"]
