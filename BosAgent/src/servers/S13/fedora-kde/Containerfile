FROM ubuntu:24.04 AS theme-build

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl ca-certificates sassc libglib2.0-dev-bin libxml2-utils imagemagick \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /out/themes /out/icons /out/wallpapers

# ── GTK theme: Fluent-round-Dark ──────────────────────────────────────────────
RUN curl -fsSL "https://github.com/vinceliuice/Fluent-gtk-theme/archive/refs/heads/master.tar.gz" \
        -o /tmp/fluent-gtk.tar.gz \
    && tar -xzf /tmp/fluent-gtk.tar.gz -C /tmp/ \
    && FLUENTDIR=$(find /tmp -maxdepth 1 -type d -name 'Fluent-gtk-theme-*' | head -1) \
    && bash "$FLUENTDIR/install.sh" -d /out/themes --tweaks round \
    && rm -rf /tmp/fluent-gtk.tar.gz "$FLUENTDIR"

# ── Icon theme: Fluent-dark ───────────────────────────────────────────────────
RUN curl -fsSL "https://github.com/vinceliuice/Fluent-icon-theme/archive/refs/heads/master.tar.gz" \
        -o /tmp/fluent-icons.tar.gz \
    && tar -xzf /tmp/fluent-icons.tar.gz -C /tmp/ \
    && bash /tmp/Fluent-icon-theme-master/install.sh -d /out/icons \
    && rm -rf /tmp/fluent-icons.tar.gz /tmp/Fluent-icon-theme-master


# ── xfwm4 theme: Fluent-round-Dark (botones reales desde el repo) ─────────────
RUN curl -fsSL "https://github.com/vinceliuice/Fluent-gtk-theme/archive/refs/heads/master.tar.gz" \
        -o /tmp/fluent2.tar.gz \
    && tar -xzf /tmp/fluent2.tar.gz -C /tmp/ \
    && FLUENTDIR=$(find /tmp -maxdepth 1 -type d -name 'Fluent-gtk-theme-*' | head -1) \
    && if [ -d "$FLUENTDIR/xfwm4" ]; then \
         cp -r "$FLUENTDIR/xfwm4" /out/xfwm4/; \
       fi \
    && rm -rf /tmp/fluent2.tar.gz "$FLUENTDIR"

# ── Wallpaper Windows 11 Bloom (descarga oficial) ────────────────────────────
RUN curl -fsSL "https://raw.githubusercontent.com/microsoft/fluentui-emoji/main/assets/Hibiscus/3D/hibiscus_3d.png" \
        -o /tmp/test.png 2>/dev/null || true
# Generar wallpaper oscuro estilo W11 con gradiente azul midnight
RUN convert -size 1920x1080 \
        gradient:'#0a1628-#1a3a5c' \
        -colorspace sRGB \
        /out/wallpapers/windows11-dark.jpg 2>/dev/null \
    || printf '\x89PNG\r\n' > /out/wallpapers/windows11-dark.jpg

# ── Imagen final ───────────────────────────────────────────────────────────────
FROM ubuntu:24.04

LABEL maintainer="SBOS" \
      description="SBOS Corporate Desktop — Ubuntu 24.04 + XFCE4 + TigerVNC + noVNC + Windows 11 Theme" \
      version="5.3.0"

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=es_ES.UTF-8 \
    LC_ALL=es_ES.UTF-8 \
    DISPLAY=:1 \
    RESOLUTION=1920x1080 \
    DEPTH=24 \
    LIBGL_ALWAYS_SOFTWARE=1 \
    GALLIUM_DRIVER=llvmpipe \
    NO_AT_BRIDGE=1

# ── Paquetes base ──────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    # XFCE4 escritorio
    xfce4 xfce4-terminal xfce4-notifyd xfce4-whiskermenu-plugin \
    xfce4-taskmanager xfce4-screenshooter xfce4-power-manager \
    mousepad thunar thunar-archive-plugin \
    # VNC + websockify (noVNC 1.5.0 desde GitHub)
    tigervnc-standalone-server websockify \
    # GTK/rendering
    libgdk-pixbuf2.0-0 gdk-pixbuf2.0-bin librsvg2-common \
    gtk2-engines-murrine gtk2-engines-pixbuf \
    libgl1-mesa-dri \
    # Fuentes Windows 11
    fonts-noto-core fonts-noto-color-emoji fonts-liberation \
    fonts-open-sans fonts-ubuntu \
    # Iconos base
    adwaita-icon-theme adwaita-icon-theme-full \
    # X11 utils
    dbus-x11 xdg-user-dirs xdg-utils x11-xserver-utils x11-utils \
    hsetroot feh scrot xdotool \
    # Locales
    locales \
    # PID 1
    tini \
    # Sistema
    sudo procps curl wget ca-certificates file \
    && locale-gen es_ES.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# ── Aplicaciones de productividad ─────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Navegador web
    chromium-browser \
    # Office suite
    libreoffice-writer libreoffice-calc libreoffice-impress libreoffice-draw \
    libreoffice-l10n-es libreoffice-help-es \
    # Herramientas del sistema
    galculator file-roller \
    # Visor de imágenes
    eog \
    && rm -rf /var/lib/apt/lists/*

# ── noVNC 1.5.0 desde GitHub ──────────────────────────────────────────────────
RUN curl -fsSL https://github.com/novnc/noVNC/archive/refs/tags/v1.5.0.tar.gz \
        -o /tmp/novnc.tar.gz \
    && tar -xzf /tmp/novnc.tar.gz -C /tmp/ \
    && mkdir -p /usr/share/novnc \
    && cp -r /tmp/noVNC-1.5.0/core /usr/share/novnc/ \
    && cp -r /tmp/noVNC-1.5.0/vendor /usr/share/novnc/ \
    && cp /tmp/noVNC-1.5.0/vnc.html /usr/share/novnc/ \
    && cp /tmp/noVNC-1.5.0/vnc_lite.html /usr/share/novnc/ \
    && rm -rf /tmp/novnc.tar.gz /tmp/noVNC-1.5.0

# ── Temas desde stage build ───────────────────────────────────────────────────
COPY --from=theme-build /out/themes/ /usr/share/themes/
COPY --from=theme-build /out/icons/  /usr/share/icons/

COPY --from=theme-build /out/wallpapers/ /usr/share/backgrounds/sbos/

# Actualizar caches de iconos
RUN gtk-update-icon-cache -f /usr/share/icons/Fluent-dark 2>/dev/null || true \
    && gtk-update-icon-cache -f /usr/share/icons/Fluent 2>/dev/null || true \
&& gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true

# ── Tema XFWM4 Win11-Dark con botones visuales ───────────────────────────────
RUN mkdir -p /usr/share/xfwm4/themes/Win11-Dark
COPY resources/xfwm4-win11/ /usr/share/xfwm4/themes/Win11-Dark/

# ── LibreOffice: integración con tema oscuro ──────────────────────────────────
RUN mkdir -p /etc/libreoffice \
    && printf '[Bootstrap]\nUserInstallation=$SYSUSERCONFIG/libreoffice\n' \
       > /etc/libreoffice/bootstraprc

# ── Usuario del desktop ───────────────────────────────────────────────────────
RUN useradd -u 1001 -ms /bin/bash sbosuser \
    && echo "sbosuser ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/sbosuser \
    && chmod 440 /etc/sudoers.d/sbosuser

RUN mkdir -p /etc/sbos-desktop

# ── Archivos del sistema ──────────────────────────────────────────────────────
COPY resources/xstartup /etc/sbos-desktop/xstartup
RUN chmod +x /etc/sbos-desktop/xstartup

RUN mkdir -p /etc/xdg/xfce4/xfconf/xfce-perchannel-xml
COPY resources/xfce-defaults/xfce4/xfconf/xfce-perchannel-xml/ \
     /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/

COPY resources/novnc-index.html /usr/share/novnc/index.html
COPY resources/start-desktop.sh /start-desktop.sh
RUN chmod +x /start-desktop.sh

EXPOSE 6901

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/start-desktop.sh"]
