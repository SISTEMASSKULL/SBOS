FROM fedora:44

LABEL maintainer="SBOS" \
      description="SBOS VDI — Fedora 44 + KDE Plasma 6 + TigerVNC + noVNC 1.5.0" \
      version="1.0.0"

ENV LANG=es_ES.UTF-8 \
    LC_ALL=es_ES.UTF-8 \
    DISPLAY=:1 \
    RESOLUTION=1920x1080 \
    DEPTH=24 \
    LIBGL_ALWAYS_SOFTWARE=1 \
    GALLIUM_DRIVER=llvmpipe \
    NO_AT_BRIDGE=1 \
    HOME=/home/vdiuser

# ── Locales ────────────────────────────────────────────────────────────────────
RUN dnf install -y glibc-langpack-es && dnf clean all

# ── KDE Plasma 6 mínimo ────────────────────────────────────────────────────────
RUN dnf install -y \
    plasma-desktop \
    plasma-workspace \
    kwin \
    kde-settings \
    polkit-kde \
    plasma-breeze \
    plasma-breeze-common \
    breeze-gtk \
    breeze-cursor-theme \
    kde-gtk-config \
    xdg-user-dirs \
    xdg-utils \
    dbus-x11 \
    && dnf clean all

# ── Aplicaciones corporativas base ─────────────────────────────────────────────
RUN dnf install -y \
    konsole \
    dolphin \
    kate \
    firefox \
    libreoffice-writer \
    libreoffice-calc \
    libreoffice-impress \
    libreoffice-draw \
    libreoffice-langpack-es \
    && dnf clean all

# ── VNC + utilidades X11 ───────────────────────────────────────────────────────
RUN dnf install -y \
    tigervnc-server \
    python3-websockify \
    xrandr \
    scrot \
    tini \
    procps-ng \
    wget \
    && dnf clean all

# ── KWin X11 backend (requerido para VNC — Plasma 6 usa Wayland por defecto) ──
RUN dnf install -y kwin-x11 && dnf clean all

# ── noVNC 1.5.0 desde GitHub ──────────────────────────────────────────────────
RUN curl -fsSL https://github.com/novnc/noVNC/archive/refs/tags/v1.5.0.tar.gz \
        -o /tmp/novnc.tar.gz \
    && tar -xzf /tmp/novnc.tar.gz -C /tmp/ \
    && mkdir -p /usr/share/novnc \
    && cp -r /tmp/noVNC-1.5.0/core    /usr/share/novnc/ \
    && cp -r /tmp/noVNC-1.5.0/vendor  /usr/share/novnc/ \
    && cp    /tmp/noVNC-1.5.0/vnc.html      /usr/share/novnc/ \
    && cp    /tmp/noVNC-1.5.0/vnc_lite.html /usr/share/novnc/ \
    && rm -rf /tmp/novnc.tar.gz /tmp/noVNC-1.5.0

# ── Usuario VDI (futuro: PAM + Keycloak JWT lo reemplazará) ───────────────────
RUN useradd -u 1001 -ms /bin/bash vdiuser \
    && echo "vdiuser ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/vdiuser \
    && chmod 440 /etc/sudoers.d/vdiuser

# ── Estructura base para integración futura de sbos-vdi-run y bAuth Client ────
RUN mkdir -p \
    /etc/sbos-vdi/rights \
    /usr/local/bin/sbos \
    /var/log/sbos-vdi

# ── Archivos del sistema ──────────────────────────────────────────────────────
COPY resources/novnc-index.html /usr/share/novnc/index.html
COPY resources/start-desktop.sh /start-desktop.sh
RUN chmod +x /start-desktop.sh

EXPOSE 6901

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/start-desktop.sh"]
