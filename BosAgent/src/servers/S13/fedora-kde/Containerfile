FROM ubuntu:24.04 AS theme-build

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl ca-certificates sassc libglib2.0-dev-bin libxml2-utils \
    && rm -rf /var/lib/apt/lists/*

# Crear directorios de salida — COPY --from falla si no existen
RUN mkdir -p /out/themes /out/icons

RUN curl -fsSL "https://github.com/vinceliuice/Fluent-gtk-theme/archive/refs/heads/master.tar.gz" \
        -o /tmp/fluent-gtk.tar.gz \
    && tar -xzf /tmp/fluent-gtk.tar.gz -C /tmp/ \
    && FLUENTDIR=$(find /tmp -maxdepth 1 -type d -name 'Fluent-gtk-theme-*' | head -1) \
    && bash "$FLUENTDIR/install.sh" -d /out/themes --tweaks round \
    && rm -rf /tmp/fluent-gtk.tar.gz "$FLUENTDIR"

RUN curl -fsSL "https://github.com/vinceliuice/Fluent-icon-theme/archive/refs/heads/master.tar.gz" \
        -o /tmp/fluent-icons.tar.gz \
    && tar -xzf /tmp/fluent-icons.tar.gz -C /tmp/ \
    && bash /tmp/Fluent-icon-theme-master/install.sh -d /out/icons \
    && rm -rf /tmp/fluent-icons.tar.gz /tmp/Fluent-icon-theme-master

# ── Imagen final ───────────────────────────────────────────────────────────────
FROM ubuntu:24.04

LABEL maintainer="SBOS" \
      description="SBOS Corporate Desktop — Ubuntu 24.04 + XFCE4 + TigerVNC + noVNC + Windows 11 Theme" \
      version="5.2.0"

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=es_ES.UTF-8 \
    LC_ALL=es_ES.UTF-8 \
    DISPLAY=:1 \
    RESOLUTION=1920x1080 \
    DEPTH=24 \
    LIBGL_ALWAYS_SOFTWARE=1 \
    GALLIUM_DRIVER=llvmpipe \
    NO_AT_BRIDGE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    # XFCE4
    xfce4 \
    xfce4-terminal \
    xfce4-notifyd \
    xfce4-whiskermenu-plugin \
    mousepad \
    thunar \
    # VNC + websockify (noVNC 1.5.0 se instala desde GitHub más abajo)
    tigervnc-standalone-server \
    websockify \
    # GTK / rendering (loaders nativos PNG/JPEG — sin glycin, sin bwrap)
    libgdk-pixbuf2.0-0 \
    gdk-pixbuf2.0-bin \
    librsvg2-common \
    # Motor de temas GTK2 (algunos widgets XFCE usan GTK2)
    gtk2-engines-murrine \
    # Mesa software rendering (xfwm4 compositor por CPU)
    libgl1-mesa-dri \
    # Iconos y cursors
    adwaita-icon-theme \
    adwaita-icon-theme-full \
    # Fuentes
    fonts-noto-core \
    fonts-noto-color-emoji \
    fonts-liberation \
    # X11 utils
    dbus-x11 \
    xdg-user-dirs \
    xdg-utils \
    x11-xserver-utils \
    x11-utils \
    hsetroot \
    scrot \
    xdotool \
    # Español
    locales \
    # tini: PID 1 reaper de zombies para contenedor de larga vida
    tini \
    # Sistema
    sudo \
    procps \
    curl \
    wget \
    ca-certificates \
    && locale-gen es_ES.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# ── noVNC 1.5.0 desde GitHub (Ubuntu 24.04 trae 1.3.0 — incompleto) ───────────
RUN curl -fsSL https://github.com/novnc/noVNC/archive/refs/tags/v1.5.0.tar.gz \
        -o /tmp/novnc.tar.gz \
    && tar -xzf /tmp/novnc.tar.gz -C /tmp/ \
    && mkdir -p /usr/share/novnc \
    && cp -r /tmp/noVNC-1.5.0/core /usr/share/novnc/ \
    && cp -r /tmp/noVNC-1.5.0/vendor /usr/share/novnc/ \
    && cp /tmp/noVNC-1.5.0/vnc.html /usr/share/novnc/ \
    && cp /tmp/noVNC-1.5.0/vnc_lite.html /usr/share/novnc/ \
    && rm -rf /tmp/novnc.tar.gz /tmp/noVNC-1.5.0

# ── Temas desde stage build ────────────────────────────────────────────────────
COPY --from=theme-build /out/themes/ /usr/share/themes/
COPY --from=theme-build /out/icons/  /usr/share/icons/

RUN gtk-update-icon-cache -f /usr/share/icons/Fluent-dark 2>/dev/null || true \
    && gtk-update-icon-cache -f /usr/share/icons/Fluent 2>/dev/null || true \
    && gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true

# ── Tema XFWM4 Win11-Dark ──────────────────────────────────────────────────────
RUN mkdir -p /usr/share/xfwm4/themes/Win11-Dark \
    && printf '%s\n' \
       'active_color_1=#202020' \
       'active_color_2=#202020' \
       'active_mid_color=#202020' \
       'inactive_color_1=#2a2a2a' \
       'inactive_color_2=#2a2a2a' \
       'inactive_mid_color=#2a2a2a' \
       'active_text_color=#f0f0f0' \
       'inactive_text_color=#888888' \
       'active_border_color=#3a3a3a' \
       'inactive_border_color=#3a3a3a' \
       'active_hilight_1=#0078d4' \
       'active_hilight_2=#005fb8' \
       'inactive_hilight_1=#3a3a3a' \
       'inactive_hilight_2=#3a3a3a' \
       'button_layout=O|HMC' \
       'button_offset=2' \
       'button_spacing=6' \
       'full_width_title=true' \
       'show_app_icon=true' \
       'title_shadow_active=false' \
       'title_shadow_inactive=false' \
       'title_vertical_offset_active=1' \
       'title_vertical_offset_inactive=1' \
       > /usr/share/xfwm4/themes/Win11-Dark/themerc

# ── Usuario del desktop ────────────────────────────────────────────────────────
RUN useradd -u 1001 -ms /bin/bash sbosuser && \
    echo "sbosuser ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/sbosuser && \
    chmod 440 /etc/sudoers.d/sbosuser

RUN mkdir -p /etc/sbos-desktop

# ── Archivos del sistema ───────────────────────────────────────────────────────
COPY resources/xstartup /etc/sbos-desktop/xstartup
RUN chmod +x /etc/sbos-desktop/xstartup

# Defaults XFCE al path canónico del sistema — xfce4-session los carga automáticamente
RUN mkdir -p /etc/xdg/xfce4/xfconf/xfce-perchannel-xml
COPY resources/xfce-defaults/xfce4/xfconf/xfce-perchannel-xml/ /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/

COPY resources/novnc-index.html /usr/share/novnc/index.html
COPY resources/start-desktop.sh /start-desktop.sh
RUN chmod +x /start-desktop.sh

EXPOSE 6901

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/start-desktop.sh"]
