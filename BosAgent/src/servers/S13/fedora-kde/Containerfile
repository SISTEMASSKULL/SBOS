FROM registry.fedoraproject.org/fedora:44

LABEL maintainer="SBOS" \
      description="SBOS Corporate Desktop — Fedora 44 KDE Plasma 6 + TigerVNC + noVNC + Windows 11 Theme (kwin + Fluent-kde + Kvantum)" \
      version="3.0.0"

ENV LANG=es_ES.UTF-8 \
    LC_ALL=es_ES.UTF-8 \
    DISPLAY=:1 \
    RESOLUTION=1920x1080 \
    DEPTH=24

# Instalar KDE Plasma 6 + TigerVNC + noVNC + compositor + utilidades
RUN dnf install -y --setopt=install_weak_deps=False --skip-unavailable \
    # Entorno de escritorio KDE Plasma 6
    plasma-workspace \
    kwin \
    plasma-systemsettings \
    plasma-nm \
    plasma-pa \
    # Aplicaciones esenciales del desktop
    konsole \
    dolphin \
    spectacle \
    kate \
    ark \
    # kwin es el WM nativo de KDE — decoraciones Aurorae + compositor XRender (compatible VNC)
    # openbox se mantiene como fallback de emergencia
    openbox \
    # kvantum: motor de estilos Qt — aspecto Windows 11 para apps Qt/KDE
    kvantum \
    # Browser para SSO con Keycloak
    chromium \
    # VNC: TigerVNC crea su propio display virtual (Xvnc)
    tigervnc-server \
    # noVNC: cliente web HTML5 + proxy websocket
    novnc \
    python3-websockify \
    # Soporte X11 y dbus
    dbus-x11 \
    xdg-user-dirs \
    xdg-utils \
    # GTK icon cache (para iconos Fluent)
    gtk-update-icon-cache \
    # Fuentes Windows-compatible (Win11 usa Segoe UI — aproximamos con Noto/Liberation)
    google-noto-sans-fonts \
    google-noto-serif-fonts \
    google-noto-emoji-fonts \
    liberation-fonts \
    # Localización español
    glibc-langpack-es \
    # Utilidades de sistema
    procps-ng \
    net-tools \
    curl \
    wget \
    which \
    && dnf clean all \
    && rm -rf /var/cache/dnf /var/log/dnf*

# ── Fluent-kde: Windows 11 theme completo para KDE ─────────────────────────
# Incluye: Aurorae (decoraciones ventana) + Kvantum + Plasma theme + colores
# Autor: vinceliuice — el mismo que los iconos Fluent ya instalados
RUN curl -sL "https://github.com/vinceliuice/Fluent-kde/archive/refs/heads/main.tar.gz" \
        -o /tmp/fluent-kde.tar.gz 2>/dev/null \
    || curl -sL "https://github.com/vinceliuice/Fluent-kde/archive/refs/heads/master.tar.gz" \
        -o /tmp/fluent-kde.tar.gz 2>/dev/null \
    && tar -xzC /tmp/ -f /tmp/fluent-kde.tar.gz \
    && FLUENTDIR=$(find /tmp -maxdepth 1 -type d -name 'Fluent-kde-*' | head -1) \
    && echo "Instalando Fluent-kde desde: $FLUENTDIR" \
    && bash "$FLUENTDIR/install.sh" 2>/dev/null || true \
    && rm -rf /tmp/fluent-kde.tar.gz "$FLUENTDIR"

# ── Iconos Fluent (estilo Windows 11) ──────────────────────────────────────
# vinceliuice/Fluent-icon-theme: iconos modernos tipo Fluent Design de Microsoft
RUN curl -sL "https://github.com/vinceliuice/Fluent-icon-theme/archive/refs/heads/master.tar.gz" \
        | tar -xzC /tmp/ \
    && bash /tmp/Fluent-icon-theme-master/install.sh 2>/dev/null || true \
    && rm -rf /tmp/Fluent-icon-theme-master \
    && gtk-update-icon-cache -f /usr/share/icons/Fluent-dark 2>/dev/null || true \
    && gtk-update-icon-cache -f /usr/share/icons/Fluent 2>/dev/null || true

# Crear usuario del desktop (uid fijo para volúmenes persistentes)
RUN useradd -u 1001 -ms /bin/bash sbosuser && \
    echo "sbosuser ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/sbosuser && \
    chmod 440 /etc/sudoers.d/sbosuser

# Directorio para los archivos de configuración del sistema
RUN mkdir -p /etc/sbos-desktop

# Script de inicio KDE para TigerVNC
COPY resources/xstartup /etc/sbos-desktop/xstartup
RUN chmod +x /etc/sbos-desktop/xstartup

# Configuración KDE inicial — tema Windows 11
COPY resources/kde-defaults/ /etc/sbos-desktop/kde-defaults/

# index.html personalizado para noVNC
COPY resources/novnc-index.html /usr/share/novnc/index.html

# Punto de entrada del contenedor
COPY resources/start-desktop.sh /start-desktop.sh
RUN chmod +x /start-desktop.sh

# noVNC sirve en :6901 (websockify proxy → VNC :5900)
EXPOSE 6901

CMD ["/start-desktop.sh"]
