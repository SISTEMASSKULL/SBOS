FROM registry.fedoraproject.org/fedora:44

LABEL maintainer="SBOS" \
      description="SBOS Corporate Desktop — Fedora 44 KDE Plasma 6 + TigerVNC + noVNC + Win11 Theme" \
      version="2.0.0"

ENV LANG=es_ES.UTF-8 \
    LC_ALL=es_ES.UTF-8 \
    DISPLAY=:1 \
    RESOLUTION=1920x1080 \
    DEPTH=24

# Instalar KDE Plasma 6 + TigerVNC + noVNC + compositor + utilidades
RUN dnf install -y --setopt=install_weak_deps=False --skip-unavailable \
    # Entorno de escritorio KDE Plasma 6
    plasma-workspace \
    kwin \
    plasma-systemsettings \
    plasma-nm \
    plasma-pa \
    # Aplicaciones esenciales del desktop
    konsole \
    dolphin \
    spectacle \
    kate \
    ark \
    # openbox: gestor de ventanas X11 (kwin_x11 fue eliminado en Plasma 6)
    openbox \
    # picom: compositor X11 — bordes redondeados + sombras (Windows 11 style)
    picom \
    # Browser para SSO con Keycloak
    chromium \
    # VNC: TigerVNC crea su propio display virtual (Xvnc)
    tigervnc-server \
    # noVNC: cliente web HTML5 + proxy websocket
    novnc \
    python3-websockify \
    # Soporte X11 y dbus
    dbus-x11 \
    xdg-user-dirs \
    xdg-utils \
    # GTK icon cache (para iconos Fluent)
    gtk-update-icon-cache \
    # Fuentes Windows-compatible (Win11 usa Segoe UI — aproximamos con Noto/Liberation)
    google-noto-sans-fonts \
    google-noto-serif-fonts \
    google-noto-emoji-fonts \
    liberation-fonts \
    # Localización español
    glibc-langpack-es \
    # Utilidades de sistema
    procps-ng \
    net-tools \
    curl \
    wget \
    which \
    && dnf clean all \
    && rm -rf /var/cache/dnf /var/log/dnf*

# ── Tema Windows 11 Dark para OpenBox ──────────────────────────────────────
# Marco de ventana moderno: barra de título oscura, botones de control Win11
RUN mkdir -p /usr/share/themes/Win11-Dark/openbox-3 \
    && cat > /usr/share/themes/Win11-Dark/openbox-3/themerc <<'THEMERC'
# Win11-Dark — OpenBox window theme inspired by Windows 11 Fluent Design
border.width: 1
border.color: #3a3a3a
padding.width: 6
padding.height: 5
menu.border.width: 1
menu.border.color: #3a3a3a

# Ventana activa
window.active.title.bg:                    flat solid
window.active.title.bg.color:              #202020
window.active.label.bg:                    parentrelative
window.active.label.text.color:            #ffffff
window.active.label.text.font:             Sans:size=9:bold
window.active.handle.bg:                   flat solid
window.active.handle.bg.color:             #202020
window.active.grip.bg:                     flat solid
window.active.grip.bg.color:               #505050

# Ventana inactiva
window.inactive.title.bg:                  flat solid
window.inactive.title.bg.color:            #2a2a2a
window.inactive.label.bg:                  parentrelative
window.inactive.label.text.color:          #888888
window.inactive.label.text.font:           Sans:size=9
window.inactive.handle.bg:                 flat solid
window.inactive.handle.bg.color:           #2a2a2a
window.inactive.grip.bg:                   flat solid
window.inactive.grip.bg.color:             #3a3a3a

# Botones de control (activos)
window.active.button.unpressed.bg:         flat solid
window.active.button.unpressed.bg.color:   #202020
window.active.button.unpressed.image.color: #cccccc
window.active.button.hover.bg:             flat solid
window.active.button.hover.bg.color:       #505050
window.active.button.hover.image.color:    #ffffff
window.active.button.pressed.bg:           flat solid
window.active.button.pressed.bg.color:     #303030
window.active.button.pressed.image.color:  #ffffff
# Botón cerrar — rojo al pasar el cursor (igual que Win11)
window.active.button.close.hover.bg:       flat solid
window.active.button.close.hover.bg.color: #c42b1c
window.active.button.close.hover.image.color: #ffffff
window.active.button.close.pressed.bg:     flat solid
window.active.button.close.pressed.bg.color: #d32f2f

# Botones inactivos
window.inactive.button.unpressed.bg:       flat solid
window.inactive.button.unpressed.bg.color: #2a2a2a
window.inactive.button.unpressed.image.color: #555555

# Menú contextual
menu.items.bg:                             flat solid
menu.items.bg.color:                       #2d2d2d
menu.items.text.color:                     #e0e0e0
menu.items.font:                           Sans:size=9
menu.items.active.bg:                      flat solid
menu.items.active.bg.color:                #0078d4
menu.items.active.text.color:              #ffffff
menu.title.bg:                             flat solid
menu.title.bg.color:                       #1a1a1a
menu.title.text.color:                     #c0c0c0
menu.title.text.font:                      Sans:size=9:bold
osd.bg:                                    flat solid
osd.bg.color:                              #202020
osd.border.color:                          #3a3a3a
osd.border.width:                          1
osd.label.text.color:                      #ffffff
THEMERC

