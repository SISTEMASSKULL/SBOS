#!/bin/bash
# xstartup — XFCE4 + Windows 11 theme (Fluent-Dark + Win11-Dark xfwm4 + Kvantum)
# xfwm4 tiene compositor software propio — no necesita kwin ni GPU

export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=XFCE
export DESKTOP_SESSION=xfce
export QT_QPA_PLATFORM=xcb
export QT_STYLE_OVERRIDE=kvantum
export XCURSOR_THEME=Fluent-dark
export XCURSOR_SIZE=24
export XDG_RUNTIME_DIR="/run/user/$(id -u)"

if [[ -z "${DBUS_SESSION_BUS_ADDRESS}" ]]; then
    eval "$(dbus-launch --sh-syntax 2>/dev/null)" || true
    export DBUS_SESSION_BUS_ADDRESS
fi

xdg-user-dirs-update 2>/dev/null || true

# Copiar config XFCE la primera vez (o si el flag no existe)
if [[ ! -f ~/.config/xfce-sbos-initialized ]]; then
    mkdir -p ~/.config
    cp -r /etc/sbos-desktop/xfce-defaults/. ~/.config/ 2>/dev/null || true
    touch ~/.config/xfce-sbos-initialized
fi

# ── xfwm4: WM + compositor software (XRender, sin GPU) ──────────────────────
/usr/bin/xfwm4 --compositor=on --display=:1 2>/dev/null &
sleep 1

# ── xfdesktop: fondo de pantalla Win11 + iconos del escritorio ───────────────
/usr/bin/xfdesktop --display=:1 2>/dev/null &
sleep 1

# ── xfce4-panel: taskbar estilo Windows 11 (panel inferior) ─────────────────
/usr/bin/xfce4-panel --display=:1 2>/dev/null &
sleep 1

# ── Aplicar configuración vía xfconf (fondo + tema) ─────────────────────────
# xfconf-query necesita DBUS activo — esperar a que xfce4-panel arranque
sleep 2

# Fondo Windows 11 Bloom (intentar múltiples monitores que Xvnc puede reportar)
for monitor in VNC-0 0; do
    xfconf-query -c xfce4-desktop \
        -p "/backdrop/screen0/monitor${monitor}/workspace0/last-image" \
        -s "/usr/share/wallpapers/Windows11/contents/images/1920x1080.jpg" \
        2>/dev/null || true
    xfconf-query -c xfce4-desktop \
        -p "/backdrop/screen0/monitor${monitor}/workspace0/image-style" \
        -s 5 2>/dev/null || true
done

# Recargar escritorio para aplicar wallpaper
xfdesktop --reload 2>/dev/null || true

wait
