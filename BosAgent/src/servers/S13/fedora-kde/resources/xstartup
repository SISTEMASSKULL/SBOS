#!/bin/bash
# xstartup — SBOS Corporate Desktop (Windows 11 Theme)

export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=XFCE
export DESKTOP_SESSION=xfce
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export NO_AT_BRIDGE=1
export LIBGL_ALWAYS_SOFTWARE=1
export GALLIUM_DRIVER=llvmpipe
export GTK_THEME=Windows-11
export XCURSOR_THEME=Adwaita
export XCURSOR_SIZE=24
export GTK2_RC_FILES=/usr/share/themes/Windows-11/gtk-2.0/gtkrc

# D-Bus sesión
eval "$(dbus-launch --sh-syntax 2>/dev/null)" || true
export DBUS_SESSION_BUS_ADDRESS

mkdir -p /tmp/.ICE-unix && chmod 1777 /tmp/.ICE-unix 2>/dev/null || true
xdg-user-dirs-update 2>/dev/null || true

# Cursor
xsetroot -cursor_name left_ptr 2>/dev/null || true

# Wallpaper Windows 11 Bloom
WALLPAPER=/usr/share/backgrounds/sbos/windows11-bloom.jpg
if [ -f "$WALLPAPER" ]; then
    feh --bg-fill "$WALLPAPER" 2>/dev/null || \
    hsetroot -fill "$WALLPAPER" 2>/dev/null || \
    hsetroot -solid '#020b18' 2>/dev/null || true
else
    hsetroot -solid '#020b18' 2>/dev/null || xsetroot -solid '#020b18' 2>/dev/null || true
fi

# Gestor de ventanas Windows 11
xfwm4 --compositor=on &

# Configuración XFCE (aplica themes, fuentes, cursores desde xsettings.xml)
xfsettingsd --daemon &

sleep 1

# Panel de tareas
xfce4-panel &

# Servicios de fondo
thunar --daemon 2>/dev/null &
xfce4-notifyd 2>/dev/null &

# Configurar tema Windows-11 en runtime después de que el panel arranque
(
    for i in $(seq 1 30); do
        pgrep -x xfce4-panel > /dev/null 2>&1 && break
        sleep 1
    done
    sleep 3

    xfconf-query -c xsettings -p /Net/ThemeName -s "Windows-11" 2>/dev/null || true
    xfconf-query -c xsettings -p /Net/IconThemeName -s "Fluent-dark" 2>/dev/null || true
    xfconf-query -c xsettings -p /Gtk/CursorThemeName -s "Adwaita" 2>/dev/null || true
    xfconf-query -c xfwm4 -p /general/theme -s "Win11-Dark" 2>/dev/null || true
    xfconf-query -c xfwm4 -p /general/use_compositing -t bool -s true 2>/dev/null || true
    xfconf-query -c xfwm4 -p /general/title_alignment -s "left" 2>/dev/null || true
    xfconf-query -c xfwm4 -p /general/button_layout -s "O|HMC" 2>/dev/null || true
) &

wait
