#!/bin/bash
# xstartup — sesión KDE Plasma 6 + Windows 11 theme para Xvnc
# WM: openbox (kwin_x11 eliminado en Plasma 6) + Fluent plasma theme + Win11-Dark decs

export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=KDE
export DESKTOP_SESSION=plasma
export QT_QPA_PLATFORM=xcb
export KDE_FULL_SESSION=true
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export QT_STYLE_OVERRIDE=kvantum-dark

# dbus session
if [[ -z "${DBUS_SESSION_BUS_ADDRESS}" ]]; then
    eval "$(dbus-launch --sh-syntax 2>/dev/null)" || true
    export DBUS_SESSION_BUS_ADDRESS
fi

xdg-user-dirs-update 2>/dev/null || true

# Deshabilitar KWallet
mkdir -p ~/.config
cat > ~/.config/kwalletrc << 'KWALLET'
[Wallet]
Enabled=false
First Use=false
KWALLET

if [[ ! -f ~/.config/kde-sbos-initialized ]]; then
    # Copiar config KDE defaults (kdeglobals, kwinrc, plasmarc, plasma-localerc)
    cp -r /etc/sbos-desktop/kde-defaults/. ~/.config/ 2>/dev/null || true

    # Openbox: tema Win11-Dark
    mkdir -p ~/.config/openbox
    cp /etc/sbos-desktop/kde-defaults/openbox/rc.xml ~/.config/openbox/rc.xml 2>/dev/null || true

    # Aplicar color scheme FluentDark a la sesión Plasma
    plasma-apply-colorscheme FluentDark 2>/dev/null || true

    touch ~/.config/kde-sbos-initialized
fi

# ── OpenBox: WM con tema Win11-Dark ─────────────────────────────────────────
/usr/bin/openbox --replace 2>/dev/null &
sleep 2

# ── plasmashell: panel/escritorio KDE con tema Fluent ───────────────────────
/usr/bin/plasmashell --no-respawn 2>/dev/null &

wait
