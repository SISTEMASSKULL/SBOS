#!/bin/bash
# xstartup — KDE Plasma 6 + Windows 11 theme completo (Fluent-kde + Win11-Dark)
# WM: openbox (kwin_x11 eliminado en Plasma 6) + Fluent plasma theme

export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=KDE
export DESKTOP_SESSION=plasma
export QT_QPA_PLATFORM=xcb
export KDE_FULL_SESSION=true
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export XCURSOR_THEME=Fluent-dark
export XCURSOR_SIZE=24

if [[ -z "${DBUS_SESSION_BUS_ADDRESS}" ]]; then
    eval "$(dbus-launch --sh-syntax 2>/dev/null)" || true
    export DBUS_SESSION_BUS_ADDRESS
fi

xdg-user-dirs-update 2>/dev/null || true

mkdir -p ~/.config
cat > ~/.config/kwalletrc << 'KWALLET'
[Wallet]
Enabled=false
First Use=false
KWALLET

if [[ ! -f ~/.config/kde-sbos-initialized ]]; then
    # Config KDE completa: kdeglobals, kwinrc, plasmarc, kcminputrc, Kvantum/
    cp -r /etc/sbos-desktop/kde-defaults/. ~/.config/ 2>/dev/null || true

    # Openbox Win11-Dark
    mkdir -p ~/.config/openbox
    cp /etc/sbos-desktop/kde-defaults/openbox/rc.xml ~/.config/openbox/rc.xml 2>/dev/null || true

    # Wallpaper Windows 11 (se genera al arrancar plasmashell con Fluent-dark)
    # Parchar path hardcodeado del dev del tema (/home/vince/ → /usr/share/)
    # Se ejecuta DESPUÉS de que plasmashell escriba su config

    # Aplicar color scheme FluentDark
    plasma-apply-colorscheme FluentDark 2>/dev/null || true

    touch ~/.config/kde-sbos-initialized
fi

# ── OpenBox: WM Win11-Dark ───────────────────────────────────────────────────
/usr/bin/openbox --replace 2>/dev/null &
sleep 2

# ── plasmashell: panel Fluent-dark + escritorio ──────────────────────────────
/usr/bin/plasmashell --no-respawn 2>/dev/null &

# Parchar wallpaper path del look-and-feel Fluent (/home/vince/ hardcodeado)
sleep 8
APLETSRC="$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc"
if [[ -f "$APLETSRC" ]]; then
    sed -i 's|/home/vince/[^,=]*wallpapers/Fluent|/usr/share/wallpapers/Fluent|g' \
        "$APLETSRC" 2>/dev/null || true
    # Recargar wallpaper en sesión activa
    qdbus org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.refreshCurrentShell 2>/dev/null || true
fi

wait
