#!/bin/bash
# xstartup — SBOS Corporate Desktop (Ubuntu 24.04 + XFCE4 + Win11 Theme)

export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=XFCE
export DESKTOP_SESSION=xfce
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export NO_AT_BRIDGE=1
export LIBGL_ALWAYS_SOFTWARE=1
export GALLIUM_DRIVER=llvmpipe
export GTK_THEME=Fluent-round-Dark
export XCURSOR_THEME=Adwaita
export XCURSOR_SIZE=24

# D-Bus sesión
eval "$(dbus-launch --sh-syntax 2>/dev/null)" || true
export DBUS_SESSION_BUS_ADDRESS

mkdir -p /tmp/.ICE-unix && chmod 1777 /tmp/.ICE-unix 2>/dev/null || true
xdg-user-dirs-update 2>/dev/null || true

# Cursor theme
xsetroot -cursor_name left_ptr 2>/dev/null || true

# Wallpaper Windows 11 — gradiente oscuro corporativo
if [ -f /usr/share/backgrounds/sbos/windows11-dark.jpg ]; then
    feh --bg-fill /usr/share/backgrounds/sbos/windows11-dark.jpg 2>/dev/null || \
    hsetroot -fill /usr/share/backgrounds/sbos/windows11-dark.jpg 2>/dev/null || \
    hsetroot -solid '#0a1628' 2>/dev/null || true
else
    hsetroot -solid '#0a1628' 2>/dev/null || xsetroot -solid '#0a1628' 2>/dev/null || true
fi

# Gestor de ventanas con compositing
xfwm4 --compositor=on &

# Configuración XFCE (temas, fuentes, cursores)
xfsettingsd --daemon &

sleep 1

# Panel de tareas en la parte inferior
xfce4-panel &

# Thunar en background (apertura rápida de archivos)
thunar --daemon 2>/dev/null &

# Notificaciones
xfce4-notifyd 2>/dev/null &

# Esperar que el panel esté corriendo y verificar posición
(
    for i in $(seq 1 30); do
        pgrep -x xfce4-panel > /dev/null 2>&1 && break
        sleep 1
    done
    sleep 4

    # Aplicar configuración xfconf en runtime para garantizar el tema
    xfconf-query -c xsettings -p /Net/ThemeName -s "Fluent-round-Dark" 2>/dev/null || true
    xfconf-query -c xsettings -p /Net/IconThemeName -s "Fluent-dark" 2>/dev/null || true
    xfconf-query -c xsettings -p /Gtk/CursorThemeName -s "Adwaita" 2>/dev/null || true
    xfconf-query -c xfwm4 -p /general/theme -s "Win11-Dark" 2>/dev/null || true
    xfconf-query -c xfwm4 -p /general/use_compositing -t bool -s true 2>/dev/null || true
) &

wait
