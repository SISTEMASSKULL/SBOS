#!/bin/bash
# xstartup — sesión KDE Plasma 6 + tema Windows 11 para Xvnc (container-friendly)
# Inicia picom (compositor) + openbox (WM) + plasmashell (panel/escritorio)

export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=KDE
export DESKTOP_SESSION=plasma
export QT_QPA_PLATFORM=xcb
export KDE_FULL_SESSION=true
export XDG_RUNTIME_DIR="/run/user/$(id -u)"

# Directorios de configuración
xdg-user-dirs-update 2>/dev/null || true

# dbus session
if [[ -z "${DBUS_SESSION_BUS_ADDRESS}" ]]; then
    eval "$(dbus-launch --sh-syntax 2>/dev/null)" || true
    export DBUS_SESSION_BUS_ADDRESS
fi

# Deshabilitar KWallet (no funciona en contenedor sin PAM)
mkdir -p ~/.config
cat > ~/.config/kwalletrc << 'KWALLET'
[Wallet]
Enabled=false
First Use=false
KWALLET

# Aplicar configuración KDE + tema Windows 11 al primer arranque
if [[ ! -f ~/.config/kde-sbos-initialized ]]; then
    # Config KDE (colores, iconos, fuentes)
    cp -r /etc/sbos-desktop/kde-defaults/. ~/.config/ 2>/dev/null || true

    # Config OpenBox (tema Win11-Dark)
    mkdir -p ~/.config/openbox
    cp /etc/sbos-desktop/kde-defaults/openbox/rc.xml ~/.config/openbox/rc.xml 2>/dev/null || true

    # Config picom (bordes redondeados)
    cp /etc/sbos-desktop/kde-defaults/picom.conf ~/.config/picom.conf 2>/dev/null || true

    # Aplicar color scheme Windows11Dark a KDE Plasma
    if command -v plasma-apply-colorscheme > /dev/null 2>&1; then
        plasma-apply-colorscheme Windows11Dark 2>/dev/null || true
    fi

    touch ~/.config/kde-sbos-initialized
fi

# ── Picom: compositor X11 — bordes redondeados + sombras (Win11 style) ─────
if command -v picom > /dev/null 2>&1; then
    picom --config ~/.config/picom.conf --daemon 2>/dev/null &
    sleep 1
fi

# ── OpenBox: gestor de ventanas X11 con tema Win11-Dark ────────────────────
# openbox provee gestión de ventanas nativa X11 sin GPU, compatible con VNC
/usr/bin/openbox --replace 2>/dev/null &
sleep 2

# ── plasmashell: escritorio + barra de tareas KDE ──────────────────────────
/usr/bin/plasmashell --no-respawn 2>/dev/null &

# Mantener la sesión activa hasta que Xvnc cierre
wait
