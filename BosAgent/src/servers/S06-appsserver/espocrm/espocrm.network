---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: espocrm-netpol
  namespace: sbos-apps
spec:
  podSelector:
    matchLabels:
      app: espocrm
  policyTypes:
    - Ingress
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              sbos-role: internal

      ports:
        - protocol: TCP
          port: 8080
