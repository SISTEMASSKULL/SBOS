---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: alloy-netpol
  namespace: sbos-monitor
spec:
  podSelector:
    matchLabels:
      app: alloy
  policyTypes:
    - Ingress
    - Egress
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              sbos-role: internal
      ports:
        - protocol: TCP
          port: 12345
  egress:
    - to:
        - podSelector:
            matchLabels:
              app: loki
      ports:
        - protocol: TCP
          port: 3100
