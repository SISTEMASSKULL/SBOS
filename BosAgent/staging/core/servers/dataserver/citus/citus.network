---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: citus-netpol
  namespace: sbos-data
spec:
  podSelector:
    matchLabels:
      app: citus
  policyTypes:
    - Ingress
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              sbos-role: internal

      ports:
        - protocol: TCP
          port: 5432
