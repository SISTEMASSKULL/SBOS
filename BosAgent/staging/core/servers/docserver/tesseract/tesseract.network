---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: tesseract-netpol
  namespace: sbos-docs
spec:
  podSelector:
    matchLabels:
      app: tesseract
  policyTypes:
    - Ingress
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              sbos-role: internal

      ports:
        - protocol: TCP
          port: 5000
