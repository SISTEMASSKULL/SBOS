                                        "checkAuthorization": true,
                                        "validateFormat": true,
                                        "verifyBusinessRules": true
                                    }
                                },

                                // Registro de cambios
                                // Propósito: Mantiene historial de modificaciones
                                "changeLogging": {
                                    "logLevel": "detailed",
