                        "differentialPrivacy": {
                            "enabled": true,
                            "epsilon": 0.1,
                            "delta": 1e-5,
                            "mechanism": "gaussian",
                            "perSampleGradientClipping": true
                        },
                        "federatedLearning": {
                            "enabled": true,
