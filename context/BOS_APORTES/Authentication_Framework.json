                                    }
                                }
                            }
                        }
                    }
                }
            },
            // Sistema de Prevención de Pérdida de Datos Avanzado (DLP)
            // Propósito: Previene la fuga no autorizada de datos sensibles a través de todos los canales posibles
            // Impacto práctico: Protege contra exfiltración de datos accidental o maliciosa
            // Consideraciones: Balance entre protección y productividad del usuario
            "advancedDLP": {
