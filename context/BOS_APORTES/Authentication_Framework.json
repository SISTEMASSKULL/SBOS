            // WAF para APIs
            // Propósito: Protección específica para APIs web
            "apiWaf": {
                // Reglas de Protección
                // Propósito: Define reglas de seguridad específicas
                "rules": {
                    // Protección OWASP Top 10
                    "owaspProtection": {
                        // Estado de la protección
                        "enabled": true,
