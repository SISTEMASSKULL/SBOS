                // Impacto práctico: Determina la capacidad de detección y adaptación
                "neuralArchitecture": {
                    // Tipo de Arquitectura
                    // Propósito: Especifica el diseño base del modelo neural
                    // Impacto práctico: Afecta capacidad de procesamiento y precisión
                    "type": "transformerHybrid",

                    // Capas de Procesamiento
                    // Propósito: Define la estructura interna del modelo
