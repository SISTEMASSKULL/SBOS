                                }
                            },
                            {
                                "type": "ensembleDefense",
                                "parameters": {
                                    "modelCount": 5,
                                    "votingScheme": "weighted",
                                    "diversityMetric": "prediction_divergence"
                                }
                            }
                        ],
                        "validationMetrics": {
                            "robustness": {
                                "minScore": 0.9,
                                "testCases": "adversarial"
                            },
                            "accuracy": {
                                "minScore": 0.95,
                                "balancedMetrics": true
                            }
                        }
                    }
                },

                // Privacidad del Modelo
                // Propósito: Protege datos de entrenamiento y modelo
                "modelPrivacy": {
