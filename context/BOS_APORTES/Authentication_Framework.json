                        "rulesets": {
                            "injection": true,
                            "xss": true,
                            "authentication": true,
                            "authorization": true
                        }
                    },
                    // Protección contra Bots
                    "botProtection": {
                        // Estado de la protección
                        "enabled": true,
                        // Métodos de detección
                        "detection": {
                            "fingerprinting": true,
                            "behavioral": true,
