---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: grafana-netpol
  namespace: sbos-monitor
spec:
  podSelector:
    matchLabels:
      app: grafana
  policyTypes:
    - Ingress
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              sbos-role: internal
        - namespaceSelector:
            matchLabels:
              sbos-role: ingress
      ports:
        - protocol: TCP
          port: 3000
