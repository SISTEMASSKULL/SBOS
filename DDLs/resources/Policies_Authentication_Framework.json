                    "emergency_override": true // Anulación de emergencia
                  }
                }
              }
            }
          },

          // Planes de Comunicación
          "communication_plans": {
            // Notificación a Interesados
            "stakeholder_notification": {
              // Matriz de Notificación
              "notification_matrix": {
                // Incidente de Seguridad
                "security_incident": {
                  // Notificación Inmediata
                  "immediate": [
                    "security_team", // Equipo de seguridad
                    "incident_response", // Respuesta a incidentes
                    "executive_team" // Equipo ejecutivo
                  ],
                  // Notificación Prioritaria
                  "priority": [
                    "affected_users", // Usuarios afectados
                    "system_administrators", // Administradores de sistema
                    "compliance_team" // Equipo de cumplimiento
                  ],
                  // Notificación Estándar
                  "standard": [
                    "all_users", // Todos los usuarios
