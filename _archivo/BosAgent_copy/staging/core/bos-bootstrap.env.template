# BOS Bootstrap — tenant inicial
# Este archivo es la fuente de verdad del bootstrap.
# Crecerá con el tiempo durante el desarrollo.
#
# COPIAR a bos-bootstrap.env y completar los valores antes de desplegar.
# NUNCA versionar bos-bootstrap.env en git.
#
# R16: sin hardcode — todos los parámetros aquí.

BOS_ROOT_USER=root
BOS_ROOT_PASSWORD=
BOS_TENANT_ID=
BOS_TENANT_NAME=
BOS_TENANT_DOMAIN=
BOS_HOST_IP=
BOS_CONTAINER_NAME=sbos-greenfield
BOS_NETWORK=sbos-staging
BOS_CGROUP_PATH=/sys/fs/cgroup/k8s.io
