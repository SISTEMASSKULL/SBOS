---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: sbos-bootstrap-os-netpol
  namespace: sbos-installer
spec:
  podSelector:
    matchLabels:
      app: sbos-bootstrap-os
  policyTypes:
    - Ingress
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              sbos-role: internal

      ports:
        - protocol: TCP
          port: 80
