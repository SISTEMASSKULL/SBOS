# ══════════════════════════════════════════════════════════════════════════════
# MODELO DE 3 CAPAS DE PUERTOS — SBOS-050-PORT-CATALOG.md v3.0
# ══════════════════════════════════════════════════════════════════════════════
# Fuente de verdad: SBOS-050-PORT-CATALOG.md + port-registry.json
# Herramienta rápida: ./portctl.sh <comando>
# Principios P1-P10: deny-all por defecto, minima superficie, puertos canonicos inmutables
# ==============================================================================

# === CAPA 3: EXPOSICIÓN EXTERNA (host Ubuntu, UFW) ============================
# Solo 3 puertos abiertos al exterior. Principio P2 SBOS-050 §7.1
SBOS_UFW_EXTERNAL_TCP="22,80,443"
SBOS_UFW_EXTERNAL_UDP="51820"  # WireGuard VPN (condicional)

# === CAPA 2: CLUSTERIP K8s SBOS (por servidor lógico) =========================
# Fórmula: BASE + (FICHA×10) + TIPO  (§12 SBOS-050)
# TIPO: 0=HTTP 1=HTTPS 2=metrics 3=healthcheck 4=admin 5=gRPC 6=WS 7=secondary 8=debug 9=reserved
SBOS_CLUSTERIP_S01_DATASERVER="8100-8149"
SBOS_CLUSTERIP_S02_GATEWAYSERVER="8150-8199"
SBOS_CLUSTERIP_S03_IDENTITYSERVER="8200-8249"
SBOS_CLUSTERIP_S04_ERPSERVER="8250-8299"
SBOS_CLUSTERIP_S05_DEVSERVER="8300-8399"
SBOS_CLUSTERIP_S06_APPSSERVER="8400-8499"
SBOS_CLUSTERIP_S07_REPORTSERVER="8500-8549"
SBOS_CLUSTERIP_S08_DOCSERVER="8550-8599"
SBOS_CLUSTERIP_S09_SEARCHSERVER="8600-8649"
SBOS_CLUSTERIP_S10_COMMSSERVER="8650-8749"
SBOS_CLUSTERIP_S11_VDISERVER="8750-8799"
SBOS_CLUSTERIP_S12_MONITORSERVER="8800-8849"
SBOS_CLUSTERIP_S13_GEOSERVER="8850-8899"
SBOS_CLUSTERIP_S14_OPSSERVER="8900-8949"
SBOS_CLUSTERIP_S15_AISERVER="8950-8999"

# === CAPA 1: CONTAINER PORTS CANÓNICOS (definidos por fabricante) =============
# Principio P3: NUNCA se modifican. El Service K8s los mapea al ClusterIP SBOS.
SBOS_CONTAINER_POSTGRESQL=5432
SBOS_CONTAINER_REDIS=6379
SBOS_CONTAINER_MYSQL=3306
SBOS_CONTAINER_MONGODB=27017
SBOS_CONTAINER_MINIO_API=9000
SBOS_CONTAINER_MINIO_CONSOLE=9001
SBOS_CONTAINER_KEYCLOAK=8080
SBOS_CONTAINER_VAULT=8200
SBOS_CONTAINER_NGINX_HTTP=80
SBOS_CONTAINER_NGINX_HTTPS=443
SBOS_CONTAINER_KONG_PROXY=8000
SBOS_CONTAINER_KONG_ADMIN=8001
SBOS_CONTAINER_PROMETHEUS=9090
SBOS_CONTAINER_GRAFANA=3000
SBOS_CONTAINER_ELASTICSEARCH=9200
SBOS_CONTAINER_ELASTIC_PEER=9300
SBOS_CONTAINER_AMQP=5672
SBOS_CONTAINER_AMQPS=5671
SBOS_CONTAINER_RABBITMQ_MGMT=15672
SBOS_CONTAINER_TYPESENSE=8108
SBOS_CONTAINER_QDRANT_HTTP=6333
SBOS_CONTAINER_QDRANT_GRPC=6334
SBOS_CONTAINER_OLLAMA=11434
SBOS_CONTAINER_SMTP=25
SBOS_CONTAINER_IMAPS=993

# === DAEMONS SOBERANOS (rango 9400-9499, host Ubuntu) =========================
# UFW: solo localhost + CIDR_PODS. P9: HTTP entre daemons VETADO.
SBOS_DAEMON_BOS_WS=9440
SBOS_DAEMON_BOS_API=9441
SBOS_DAEMON_BOS_METRICS=9442
SBOS_DAEMON_BOS_HEALTH=9443
SBOS_DAEMON_BHNEXUS_WS_MTLS=9444
SBOS_DAEMON_BHNEXUS_METRICS=9445
SBOS_DAEMON_BHNEXUS_HEALTH=9446
SBOS_DAEMON_BAUTH_WS=9450
SBOS_DAEMON_BAUTH_API=9451
SBOS_DAEMON_BAUTH_METRICS=9452
SBOS_DAEMON_BAUTH_HEALTH=9453
SBOS_DAEMON_BKERNEL_METRICS=9460
SBOS_DAEMON_BKERNEL_HEALTH=9461
SBOS_DAEMON_BIEDATA_METRICS=9470
SBOS_DAEMON_BIEDATA_HEALTH=9471
SBOS_DAEMON_BCOMPASS_WS=9480
SBOS_DAEMON_BCOMPASS_API=9481
SBOS_DAEMON_BCOMPASS_METRICS=9482
SBOS_DAEMON_BCOMPASS_HEALTH=9483
