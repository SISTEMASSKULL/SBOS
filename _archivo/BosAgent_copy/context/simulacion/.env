# ══════════════════════════════════════════════════════════════════════════════
# MAPEO PRODUCTO (SBOS-036) → SUBDOMINIO → FICHAS
# ══════════════════════════════════════════════════════════════════════════════
# 8 productos. Todos dependen de bootstrap (PostgreSQL + Keycloak + Kong + Vault + MinIO).
# Instalación: bosctl product install <nombre>
# ==============================================================================
# PRODUCTO        CATEGORÍA       SUBDOMINIO      FICHAS  TIEMPO
# bootstrap       platform        (infra base)    16      ~48 min — PREREQUISITO
# mail            communication   mail            4       ~12 min
# erp             business        erp             2        ~8 min
# documents       business        docs            5       ~10 min
# monitoring      operations      monitor,logs    4        ~8 min
# vdi             platform        files           4       ~15 min
# ai              intelligence    ai              6       ~12 min — OPCIONAL
# devops          operations      git,registry    3       ~15 min

# ── IDENTIDAD DEL SBOS ────────────────────────────────────────────────────────
SBOS_TENANT_ID=sbos
SBOS_TENANT_NAME="SBOS Cloud"
SBOS_TENANT_DISPLAY_NAME="SKSistemas SBOS"
SBOS_ENV=staging

# ── SUPERUSUARIO ──────────────────────────────────────────────────────────────
SBOS_SUPERUSER_USERNAME=admin
SBOS_SUPERUSER_EMAIL=admin@sksistemas.com
SBOS_SUPERUSER_PASSWORD=          # SECRETO — vault

# ── ADMINISTRADOR ─────────────────────────────────────────────────────────────
SBOS_ADMIN_USERNAME=administrador
SBOS_ADMIN_EMAIL=administrador@sksistemas.com
SBOS_ADMIN_PASSWORD=              # SECRETO — vault

# ── PRIMERA EMPRESA ───────────────────────────────────────────────────────────
SBOS_COMPANY_NAME="SKSistemas"
SBOS_COMPANY_DISPLAY_NAME="SK Sistemas"
SBOS_COMPANY_TAX_ID=
SBOS_COMPANY_ADDRESS=
SBOS_COMPANY_PHONE=
SBOS_COMPANY_EMAIL=contacto@sksistemas.com
SBOS_COMPANY_WEBSITE=https://sksistemas.com
SBOS_COMPANY_LOGO_URL=

# ── BASE DE DATOS ─────────────────────────────────────────────────────────────
# Descubierto en: postgresql (ficha 100)
SBOS_DB_HOST=postgresql.sbos-data.svc.cluster.local
SBOS_DB_PORT=5432
SBOS_DB_NAME=sbos
SBOS_DB_USER=sbos
SBOS_DB_PASSWORD=                 # SECRETO — vault

# ── SMTP / CORREO ─────────────────────────────────────────────────────────────
SBOS_SMTP_HOST=mail.sksistemas.com
SBOS_SMTP_PORT=587
SBOS_SMTP_USER=
SBOS_SMTP_PASSWORD=               # SECRETO — vault
SBOS_SMTP_FROM=noreply@sksistemas.com

# ── RED INTERNA KUBERNETES ────────────────────────────────────────────────────
# Descubierto en: sbos-bootstrap-platform (ficha 10), linkerd (ficha 150)
SBOS_K8S_POD_CIDR=10.244.0.0/16
SBOS_K8S_SERVICE_CIDR=10.96.0.0/12
SBOS_K8S_CLUSTER_DOMAIN=cluster.local
SBOS_K8S_CLUSTER_NAME=sbos-cluster
SBOS_K8S_CNI=flannel                # tunl0 10.244.66.1 ya presente

# ── NGINX / TLS ───────────────────────────────────────────────────────────────
# Descubierto en: nginx (ficha 50), kong (ficha 145)
SBOS_NGINX_HTTP_PORT=80
SBOS_NGINX_HTTPS_PORT=443
SBOS_NGINX_WORKER_PROCESSES=auto
SBOS_NGINX_WORKER_CONNECTIONS=4096
SBOS_TLS_CERT_DIR=/etc/bos/certs
SBOS_TLS_CERT_EMAIL=admin@sksistemas.com     # Let's Encrypt
SBOS_TLS_MODE=production                     # staging | production

# ── RUTAS DE CONFIGURACIÓN ────────────────────────────────────────────────────
SBOS_CONFIG_DIR=/etc/bos
SBOS_BLIBS_DIR=/etc/bos/blibs
SBOS_SIMULACION_DIR=/etc/bos/blibs/simulacion
SBOS_APROBADAS_DIR=/etc/bos/blibs/aprobadas
SBOS_SERVERS_DIR=/etc/bos/blibs/servers
SBOS_STATE_FILE=/etc/bos/.sbos_state.json
SBOS_LOG_DIR=/var/log/bos

# ── LOGOS Y ACTIVOS VISUALES ──────────────────────────────────────────────────
SBOS_LOGO_PRINCIPAL=
SBOS_LOGO_HEADER=
SBOS_FAVICON=
SBOS_COLOR_PRIMARIO=#1a56db
SBOS_COLOR_SECUNDARIO=#0e3b8c

# ── SEGURIDAD ─────────────────────────────────────────────────────────────────
# Descubierto en: vault (ficha 120), keycloak (ficha 130), cert-rotation (ficha 320)
SBOS_VAULT_PORT=8200
SBOS_VAULT_ADDR=http://vault.sbos-data.svc.cluster.local:8200
SBOS_VAULT_TOKEN=                  # SECRETO — vault bootstrap

# ── OIDC ──────────────────────────────────────────────────────────────────────
SBOS_OIDC_ISSUER=https://auth.sksistemas.com/realms/sbos
SBOS_OIDC_CLIENT_ID=sbos-core
SBOS_OIDC_CLIENT_SECRET=           # SECRETO — keycloak genera

# ── RESUMEN DNS ───────────────────────────────────────────────────────────────
# Subdominios CONFIRMADOS (11): www mail api auth status support vault desktop gateway data reports
# Subdominios PENDIENTES (14): apps docs monitor vdi git s3 cdn search ai traccar cloud chat erp idm
# Dominio raíz: necesita actualización DNS 177.222.51.73 → 144.91.76.130
# Nameservers: ns1.globaldomaingroup.com, ns2.globaldomaingroup.com

# ── POR DESCUBRIR ─────────────────────────────────────────────────────────────
# Variables que se irán agregando conforme las fichas las requieran en simulación.
# Cada entrada debe documentar: quién la necesita, desde cuándo, si es secreta.
