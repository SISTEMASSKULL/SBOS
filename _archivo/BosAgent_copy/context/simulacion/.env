SBOS_DAEMON_BSEARCH_API=9491
SBOS_DAEMON_BSEARCH_METRICS=9492
SBOS_DAEMON_BSEARCH_HEALTH=9493

# === SKULL CUSTOM APPS (rango 28100-28999) ====================================
SBOS_SKULL_SMARTTAX=28100
SBOS_SKULL_SMARTREPORT=28110
SBOS_SKULL_SMARTRATES=28120
SBOS_SKULL_SMARTORC=28130
SBOS_SKULL_SMARTVAULTFLOW=28140
SBOS_SKULL_SMARTPORTFOLIO=28150
SBOS_SKULL_SMARTPAY=28160
SBOS_SKULL_IAM_STYLE=28170
SBOS_SKULL_CMS=28180

# === PUERTOS NO DISPONIBLES (§5 SBOS-050) =====================================
# Well-Known IANA (0-1023) — solo OS y protocolos estándar
SBOS_BLOCKED_SYSTEM="22,25,53,80,110,143,179,443,465,587,993,995"
# K8s core — kubeadm preflight check (falla si ocupados)
SBOS_BLOCKED_K8S="2379-2380,6443,10248-10259"
# Linkerd mesh — sidecar en cada pod
SBOS_BLOCKED_LINKERD="4140,4143,4191,8086,9995"
# Alta conflictividad documentada — certeza absoluta P4
SBOS_BLOCKED_HIGH_CONFLICT="3000,5000,8000,8008,8080,8088,8090,8888,9000"
# Rangos completos reservados SBOS
SBOS_BLOCKED_RANGES="8100-8999,9400-9499,28100-28999,31000-31999"
# Rango dinámico IANA — NUNCA para servicios (RFC 6335)
SBOS_BLOCKED_DYNAMIC="49152-65535"

# === HERRAMIENTAS DE CONTROL DE PUERTOS =======================================
# Registro machine-readable: port-registry.json (108 apps, 15 servidores)
# Quick reference: ./portctl.sh <check|calc|list|app|available|validate|summary|daemons|skull|blocked>
SBOS_PORT_REGISTRY=port-registry.json

